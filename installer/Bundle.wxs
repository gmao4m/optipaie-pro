<?xml version="1.0" encoding="utf-8"?>
<!--
  OptiPaie PRO - Setup.exe bootstrapper (WiX Burn).
  A single Setup.exe that:
    1. Installs .NET Framework 4.8 if it is missing (already present on Windows 10
       1903+ and Windows 11, so it is skipped there).
    2. Runs the OptiPaie PRO MSI, showing its full install wizard (welcome,
       license, install-location selection, shortcuts, finish).

  WINDOWS 7 FIX: the .NET 4.8 installer is EMBEDDED offline (the full redistributable,
  Compressed="yes"), NOT downloaded from Microsoft at install time. An un-updated
  Windows 7 SP1 cannot negotiate TLS 1.2, so the old web bootstrapper failed to
  download .NET (error 0x80072f7d) and the whole install aborted before OptiPaie was
  reached. Carrying .NET offline removes that dependency entirely. The redistributable
  is fetched and Authenticode-verified at BUILD time by build-installer.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="OptiPaie PRO"
          Manufacturer="OptiPaie"
          Version="$(var.AppVersion)"
          UpgradeCode="6AE0E675-CD4B-487A-94EE-A7C84B91B2C2"
          IconSourceFile="OptiPaie.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseFile="License.rtf"
          Theme="rtfLicense" />
    </BootstrapperApplication>

    <!-- Installed .NET Framework 4.x release number (528040 = .NET 4.8). Absent key
         leaves the variable unset, so the ExePackage below is treated as not-present
         and installs .NET. -->
    <util:RegistrySearch
        Id="NetFx48ReleaseSearch"
        Variable="NetFx48Release"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
        Value="Release"
        Result="value" />

    <!-- Visual C++ 2015-2022 x86 runtime presence. The x86 runtime registers under the 32-bit
         registry view (WOW6432Node on a 64-bit OS), which this x86 search reads by default.
         Installed=1 means a compatible 14.x runtime is present; an absent key leaves the variable
         unset so the ExePackage below installs it. -->
    <util:RegistrySearch
        Id="VCppX86InstalledSearch"
        Variable="VCppX86Installed"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X86"
        Value="Installed"
        Result="value" />

    <Chain>
      <!-- .NET Framework 4.8 - EMBEDDED offline redistributable (no install-time download,
           so it works on Windows 7 SP1 with no internet / no TLS 1.2). Installed only when
           .NET 4.8 (release >= 528040) is absent. Permanent: never removed on uninstall. -->
      <ExePackage Id="NetFx48"
                  DisplayName=".NET Framework 4.8"
                  SourceFile="redist\ndp48-x86-x64-allos-enu.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="NetFx48Release AND NetFx48Release &gt;= 528040"
                  InstallArguments="/q /norestart"
                  RepairArguments="/q /norestart">
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- Visual C++ 2015-2022 x86 runtime - EMBEDDED offline. The app's PDF renderer loads the
           x86 libSkiaSharp.dll, which cannot load on a stock Windows 7 SP1 without this runtime
           (and the UCRT it carries) - document generation then fails. Installed only when absent
           (Installed=1 under the 14.0 x86 runtimes key). Permanent: never removed on uninstall.
           Exit 1638 = a newer runtime already present (treated as success). -->
      <ExePackage Id="VCRedistX86"
                  DisplayName="Microsoft Visual C++ 2015-2022 Redistributable (x86)"
                  SourceFile="redist\vc_redist.x86.exe"
                  Compressed="yes"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="VCppX86Installed AND VCppX86Installed = 1"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart">
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- The application (installed to the default location, like Chrome/Discord). -->
      <MsiPackage Id="OptiPaiePro"
                  SourceFile="output\OptiPaie PRO.msi"
                  Compressed="yes"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
