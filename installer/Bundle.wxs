<?xml version="1.0" encoding="utf-8"?>
<!--
  OptiPaie PRO - Setup.exe bootstrapper (WiX Burn). ONE source, TWO builds:

    FULL  (default)         -> "OptiPaie PRO Setup.exe"  (~150 MB)
          The runtime prerequisites (.NET 4.8 + VC++ x86) are EMBEDDED offline.
          For a FRESH install on a machine that may lack them, including an
          un-updated Windows 7 SP1 that cannot download over TLS 1.2. This is
          what a NEW customer downloads.

    LIGHT (-d Light=yes)    -> "OptiPaie PRO Update.exe"  (~38 MB)
          What the in-app AUTO-UPDATER serves to existing installs. It carries the
          app (MSI) and the VC++ x86 runtime EMBEDDED, and NO .NET package at all.
          It contains ZERO download payloads, so it never touches the network.

  WHY THE LIGHT BUILD HAS NO .NET PACKAGE (incident 2026-11-23, Win 7 SP1, 1.19.0 -> 1.43.0):
  the old light build REFERENCED .NET 4.8 and VC++ for download, on the assumption that an
  existing install has them -> "detected present -> skipped -> nothing downloaded". FALSE:
  Burn v5 still CACHES a permanent prerequisite that is already installed (plan showed
  "execute: None, cache: Vital"), so it DOWNLOADED the 116 MB .NET installer on every update.
  On Win 7 that HTTPS download fails (no TLS 1.2, 0x80072f7d) and the whole update aborted;
  on Win 10/11 it silently made every "light" update 116 MB heavier.
  Fix: the light bundle drops .NET entirely - the updater only ever runs INSIDE a working
  net48 app, so .NET 4.8 is guaranteed present - and a bal:Condition refuses to run (with a
  clear bilingual message pointing to the full Setup.exe) on a machine without .NET 4.8.
  VC++ is EMBEDDED in both builds (14 MB): it may be genuinely absent on an old install (it
  was, in that log) and must install offline. build-installer.ps1 GUARDS that neither bundle
  contains an external (download) payload.

  WINDOWS 7 (full build): .NET 4.8 and VC++ are embedded offline, so the full Setup.exe
  never downloads anything at install time either.
-->

<?ifndef Light ?>
  <?define Light = "no" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="OptiPaie PRO"
          Manufacturer="OptiPaie"
          Version="$(var.AppVersion)"
          UpgradeCode="6AE0E675-CD4B-487A-94EE-A7C84B91B2C2"
          IconSourceFile="OptiPaie.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseFile="License.rtf"
          Theme="rtfLicense" />
    </BootstrapperApplication>

    <!-- Installed .NET Framework 4.x release number (528040 = .NET 4.8). Absent key
         leaves the variable unset, so the ExePackage below is treated as not-present. -->
    <util:RegistrySearch
        Id="NetFx48ReleaseSearch"
        Variable="NetFx48Release"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
        Value="Release"
        Result="value" />

    <!-- Visual C++ 2015-2022 x86 runtime presence (32-bit registry view). -->
    <util:RegistrySearch
        Id="VCppX86InstalledSearch"
        Variable="VCppX86Installed"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X86"
        Value="Installed"
        Result="value" />

<?if $(var.Light) = "yes" ?>
    <!-- LIGHT build only: no .NET package is carried, so refuse to run where .NET 4.8 is missing
         (only possible if someone runs Update.exe by hand on a fresh machine). -->
    <bal:Condition
        Condition="NetFx48Release AND NetFx48Release &gt;= 528040"
        Message="Cette mise à jour nécessite .NET Framework 4.8, absent de cet ordinateur. Installez plutôt « OptiPaie PRO Setup.exe » (installation complète, hors ligne).&#13;&#10;&#13;&#10;هذا التحديث يتطلّب .NET Framework 4.8 غير المثبَّت على هذا الحاسوب. ثبّت بدلًا منه « OptiPaie PRO Setup.exe » (التثبيت الكامل، دون إنترنت)." />
<?endif?>

    <Chain>
      <!-- .NET Framework 4.8 - FULL build only, embedded offline. Installed only when .NET 4.8
           (release >= 528040) is absent. Permanent. The LIGHT build carries no .NET package
           (see the header): it would be cached, i.e. DOWNLOADED, even when already installed. -->
<?if $(var.Light) != "yes" ?>
      <ExePackage Id="NetFx48"
                  DisplayName=".NET Framework 4.8 (composant Windows requis / مكوّن ويندوز مطلوب)"
                  SourceFile="redist\ndp48-x86-x64-allos-enu.exe"
                  Compressed="yes"
                  PerMachine="yes" Permanent="yes" Vital="yes"
                  DetectCondition="NetFx48Release AND NetFx48Release &gt;= 528040"
                  InstallArguments="/q /norestart" RepairArguments="/q /norestart">
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
<?endif?>

      <!-- Visual C++ 2015-2022 x86 runtime. Installed only when absent. Permanent. Exit 1638 = a
           newer runtime already present (success). EMBEDDED in BOTH builds (14 MB): an old install
           can genuinely lack it (the 2026-11-23 Win 7 log did), and it must install offline. -->
      <ExePackage Id="VCRedistX86"
                  DisplayName="Microsoft Visual C++ 2015-2022 (x86) (composant Windows requis / مكوّن ويندوز مطلوب)"
                  SourceFile="redist\vc_redist.x86.exe"
                  Compressed="yes"
                  PerMachine="yes" Permanent="yes" Vital="yes"
                  DetectCondition="VCppX86Installed AND VCppX86Installed = 1"
                  InstallArguments="/install /quiet /norestart" RepairArguments="/repair /quiet /norestart">
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- The application. ALWAYS embedded in BOTH builds (it is the product, ~23 MB). -->
      <MsiPackage Id="OptiPaiePro"
                  SourceFile="output\OptiPaie PRO.msi"
                  Compressed="yes"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
