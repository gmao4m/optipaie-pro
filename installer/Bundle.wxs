<?xml version="1.0" encoding="utf-8"?>
<!--
  OptiPaie PRO - Setup.exe bootstrapper (WiX Burn). ONE source, TWO builds:

    FULL  (default)         -> "OptiPaie PRO Setup.exe"  (~150 MB)
          The runtime prerequisites (.NET 4.8 + VC++ x86) are EMBEDDED offline.
          For a FRESH install on a machine that may lack them, including an
          un-updated Windows 7 SP1 that cannot download over TLS 1.2. This is
          what a NEW customer downloads.

    LIGHT (-d Light=yes)    -> "OptiPaie PRO Update.exe"  (~MSI size)
          The SAME Burn bootstrapper, but the prerequisites are REFERENCED for
          download (DownloadUrl) instead of embedded. This is what the in-app
          AUTO-UPDATER serves to the 300 existing installs: they already run the
          product, so .NET 4.8 and the VC++ runtime are present -> the detect
          conditions below are satisfied -> the prerequisites are SKIPPED and
          nothing is downloaded. A 151 MB push to slow/mobile Algerian
          connections (the interrupted-download risk) is avoided.

  WINDOWS 7 FIX (full build): the .NET 4.8 installer is embedded offline, so the
  full Setup.exe never downloads .NET at install time (an un-updated Win 7 SP1
  cannot negotiate TLS 1.2 - error 0x80072f7d).

  MISSING PREREQUISITE on an existing install (light build): each prerequisite is
  Vital, so if it is ever absent AND cannot be obtained, Burn rolls the whole
  install back - it NEVER half-installs - and the bootstrapper names the failed
  component to the customer (bilingual DisplayName). The guidance is to run the
  full "OptiPaie PRO Setup.exe", which carries everything offline.
-->

<?ifndef Light ?>
  <?define Light = "no" ?>
<?endif?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="OptiPaie PRO"
          Manufacturer="OptiPaie"
          Version="$(var.AppVersion)"
          UpgradeCode="6AE0E675-CD4B-487A-94EE-A7C84B91B2C2"
          IconSourceFile="OptiPaie.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          LicenseFile="License.rtf"
          Theme="rtfLicense" />
    </BootstrapperApplication>

    <!-- Installed .NET Framework 4.x release number (528040 = .NET 4.8). Absent key
         leaves the variable unset, so the ExePackage below is treated as not-present. -->
    <util:RegistrySearch
        Id="NetFx48ReleaseSearch"
        Variable="NetFx48Release"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
        Value="Release"
        Result="value" />

    <!-- Visual C++ 2015-2022 x86 runtime presence (32-bit registry view). -->
    <util:RegistrySearch
        Id="VCppX86InstalledSearch"
        Variable="VCppX86Installed"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\X86"
        Value="Installed"
        Result="value" />

    <Chain>
      <!-- .NET Framework 4.8. Installed only when .NET 4.8 (release >= 528040) is absent. Permanent.
           FULL build: embedded offline (Compressed="yes"). LIGHT build: referenced for download
           (DownloadUrl, Compressed="no") - only ever fetched if actually missing; an existing
           install has it, so it is detected-present and skipped. -->
<?if $(var.Light) = "yes" ?>
      <ExePackage Id="NetFx48"
                  DisplayName=".NET Framework 4.8 (composant Windows requis / مكوّن ويندوز مطلوب)"
                  SourceFile="redist\ndp48-x86-x64-allos-enu.exe"
                  DownloadUrl="https://go.microsoft.com/fwlink/?linkid=2088631"
                  Compressed="no"
                  PerMachine="yes" Permanent="yes" Vital="yes"
                  DetectCondition="NetFx48Release AND NetFx48Release &gt;= 528040"
                  InstallArguments="/q /norestart" RepairArguments="/q /norestart">
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
<?else?>
      <ExePackage Id="NetFx48"
                  DisplayName=".NET Framework 4.8 (composant Windows requis / مكوّن ويندوز مطلوب)"
                  SourceFile="redist\ndp48-x86-x64-allos-enu.exe"
                  Compressed="yes"
                  PerMachine="yes" Permanent="yes" Vital="yes"
                  DetectCondition="NetFx48Release AND NetFx48Release &gt;= 528040"
                  InstallArguments="/q /norestart" RepairArguments="/q /norestart">
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
<?endif?>

      <!-- Visual C++ 2015-2022 x86 runtime. Installed only when absent. Permanent. Exit 1638 = a
           newer runtime already present (success). FULL: embedded. LIGHT: referenced for download
           (skipped on an existing install, which already loaded libSkiaSharp). -->
<?if $(var.Light) = "yes" ?>
      <ExePackage Id="VCRedistX86"
                  DisplayName="Microsoft Visual C++ 2015-2022 (x86) (composant Windows requis / مكوّن ويندوز مطلوب)"
                  SourceFile="redist\vc_redist.x86.exe"
                  DownloadUrl="https://aka.ms/vs/17/release/vc_redist.x86.exe"
                  Compressed="no"
                  PerMachine="yes" Permanent="yes" Vital="yes"
                  DetectCondition="VCppX86Installed AND VCppX86Installed = 1"
                  InstallArguments="/install /quiet /norestart" RepairArguments="/repair /quiet /norestart">
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
<?else?>
      <ExePackage Id="VCRedistX86"
                  DisplayName="Microsoft Visual C++ 2015-2022 (x86) (composant Windows requis / مكوّن ويندوز مطلوب)"
                  SourceFile="redist\vc_redist.x86.exe"
                  Compressed="yes"
                  PerMachine="yes" Permanent="yes" Vital="yes"
                  DetectCondition="VCppX86Installed AND VCppX86Installed = 1"
                  InstallArguments="/install /quiet /norestart" RepairArguments="/repair /quiet /norestart">
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="1641" Behavior="scheduleReboot" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
<?endif?>

      <!-- The application. ALWAYS embedded in BOTH builds (it is the product, ~23 MB) so the light
           update carries the app itself and only the prerequisites are referenced. -->
      <MsiPackage Id="OptiPaiePro"
                  SourceFile="output\OptiPaie PRO.msi"
                  Compressed="yes"
                  Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
