<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OptiPaie.Tests - QA suite.
    Primary purpose: prove the Payroll Engine against the worked examples in the
    approved specification (legal accuracy). Also covers repositories and
    migrations. Not shipped with the product.
  -->

  <PropertyGroup>
    <RootNamespace>OptiPaie.Tests</RootNamespace>
    <AssemblyName>OptiPaie.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <!-- Ed25519 signing for the license-token round-trip test (same version Services uses). -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

  <!-- The ATS/DRT coordinate layout + official form images, copied next to the test binaries so
       the non-regression test can prove the generated PDF embeds the full-page form background. -->
  <ItemGroup>
    <Content Include="..\..\src\OptiPaie.Desktop\Assets\AtsDrtTemplates\form-layout.json" Link="AtsDrtForms\form-layout.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\src\OptiPaie.Desktop\Assets\AtsDrtTemplates\ATS_image1.jpeg" Link="AtsDrtForms\ATS_image1.jpeg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\src\OptiPaie.Desktop\Assets\AtsDrtTemplates\ATS_image2.jpeg" Link="AtsDrtForms\ATS_image2.jpeg"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Content Include="..\..\src\OptiPaie.Desktop\Assets\AtsDrtTemplates\DRTFR_image1.png" Link="AtsDrtForms\DRTFR_image1.png"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Anonymized DAS reference fixtures for the byte-exact "juge de paix" test. -->
    <None Update="Fixtures\Das\das_sample_detail.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Das\das_sample_entete.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OptiPaie.Core\OptiPaie.Core.csproj" />
    <ProjectReference Include="..\..\src\OptiPaie.Common\OptiPaie.Common.csproj" />
    <ProjectReference Include="..\..\src\OptiPaie.Data\OptiPaie.Data.csproj" />
    <ProjectReference Include="..\..\src\OptiPaie.PayrollEngine\OptiPaie.PayrollEngine.csproj" />
    <ProjectReference Include="..\..\src\OptiPaie.Services\OptiPaie.Services.csproj" />
  </ItemGroup>

</Project>
