<Window x:Class="OptiPaie.Desktop.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{Binding Title}" Height="600" Width="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}">
    <Window.Resources>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="{Binding Title}" />

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Tmpl_Name}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Users_ColDepartment}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding DepartmentTag, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Tmpl_Scale}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding ScaleMax, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <DataGrid Grid.Row="2" Margin="0,14,0,0" ItemsSource="{Binding Criteria}" AutoGenerateColumns="False"
                  HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="All"
                  RowHeight="34" FontFamily="{StaticResource AppFont}" FontSize="12.5" Background="{DynamicResource Surface}"
                  RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}"
                  ColumnHeaderStyle="{StaticResource GridHeader}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Perf_Criterion}" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridCheckBoxColumn Header="{loc:Loc Tmpl_Kpi}" Binding="{Binding IsKpi, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                <DataGridCheckBoxColumn Header="{loc:Loc Tmpl_HigherBetter}" Binding="{Binding HigherIsBetter, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                <DataGridTextColumn Header="{loc:Loc Tmpl_DefaultTarget}" Binding="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}" Width="72" />
                <DataGridTemplateColumn Header="{loc:Loc Tmpl_Weight}" Width="76">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="6,0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding DataContext.SimpleMode, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="40" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Deduction}"
                                    Command="{Binding DataContext.RemoveCriterionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Perf_AddCriterion}" Command="{Binding AddCriterionCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{loc:Loc Tmpl_Normalize}" Command="{Binding NormalizeCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{loc:Loc Tmpl_Equalize}" Command="{Binding EqualizeCommand}" />
            </StackPanel>
            <CheckBox Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SimpleMode}"
                      Content="{loc:Loc Tmpl_SimpleMode}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding WeightTotalText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Deduction}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WeightBalanced}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
