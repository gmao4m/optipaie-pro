<Window x:Class="OptiPaie.Desktop.Views.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Perf_TemplateEditor}" Height="600" Width="740" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brand}" Padding="22,16">
            <TextBlock Text="{loc:Loc Perf_TemplateEditor}" Foreground="{DynamicResource TextOnBrand}" FontSize="17" FontWeight="SemiBold" />
        </Border>

        <!-- header fields -->
        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_TemplateName}" />
                <TextBox Style="{StaticResource AppTextBox}" Height="34" Margin="0,4,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Department}" />
                <TextBox Style="{StaticResource AppTextBox}" Height="34" Margin="0,4,0,0" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="22,84,22,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="{loc:Loc Perf_UseWeights}" IsChecked="{Binding IsWeighted}" VerticalContentAlignment="Center" />
                <CheckBox Content="{loc:Loc Perf_SetAsDefault}" IsChecked="{Binding IsDefault}" Margin="24,0,0,0" VerticalContentAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- criteria -->
        <Border Grid.Row="2" Margin="22,120,22,0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="30"
                            Content="{loc:Loc Perf_AddCriterion}" Command="{Binding AddCriterionCommand}" />
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{loc:Loc Perf_Criteria}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Criteria}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="80" /><ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}" Height="32" Margin="0,0,6,0"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                        <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" Height="32" Margin="0,0,6,0"
                                                  ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedCategory}" />
                                        <ComboBox Grid.Column="2" Style="{StaticResource AppComboBox}" Height="32" Margin="0,0,6,0"
                                                  ItemsSource="{Binding ScoreTypeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedScoreType}"
                                                  Visibility="{Binding IsRating, Converter={StaticResource BoolToVis}}" />
                                        <TextBox Grid.Column="2" Style="{StaticResource AppTextBox}" Height="32" Margin="0,0,6,0"
                                                 ToolTip="{loc:Loc Perf_KpiTarget}"
                                                 Text="{Binding TargetText, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsKpi, Converter={StaticResource BoolToVis}}" />
                                        <TextBox Grid.Column="3" Style="{StaticResource AppTextBox}" Height="32" Margin="0,0,6,0"
                                                 Text="{Binding WeightText, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding DataContext.ShowWeights, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                        <Button Grid.Column="4" Style="{StaticResource RowIconButton}" Content="✕"
                                                Command="{Binding DataContext.RemoveCriterionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- footer -->
        <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{loc:Loc Common_Cancel}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Content="{loc:Loc Common_Save}" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="120" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" Text="{Binding WeightSumText}"
                           Visibility="{Binding ShowWeights, Converter={StaticResource BoolToVis}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WeightValid}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusDangerText}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</Window>
