<UserControl x:Class="OptiPaie.Desktop.Views.CnasReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:OptiPaie.Desktop.Behaviors"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,4,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Cnas_Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{loc:Loc Cnas_Subtitle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Text="{loc:Loc Payroll_Year}" VerticalAlignment="Center" Margin="0,0,8,0"
                           Foreground="{DynamicResource TextMuted}" FontSize="12" />
                <ComboBox Style="{StaticResource AppComboBox}" Width="100" Height="32"
                          ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
            </StackPanel>
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <!-- No active company -->
            <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="16,12"
                    Visibility="{Binding HasCompany, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_NoCompany}" />
            </Border>

            <!-- Company-level blocker: CNAS employer number -->
            <Border Background="{DynamicResource StatusDangerSoft}" CornerRadius="10" Padding="16,12"
                    Visibility="{Binding EmployerNumberIssue, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource StatusDangerText}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusDangerText}" Text="{Binding EmployerNumberMessage}" />
                </StackPanel>
            </Border>

            <!-- Summary line -->
            <TextBlock Margin="2,14,0,0" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding HasCompany, Converter={StaticResource BoolToVis}}" />

            <!-- Everything ready -->
            <Border Background="{DynamicResource StatusSuccessSoft}" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"
                    Visibility="{Binding AllReady, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="15" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessText}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusSuccessText}" Text="{loc:Loc Cnas_AllReady}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Work-list (top) + read-only exposure diagnostic (bottom) -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Work-list: employees with blocking issues — clic sur une ligne = fiche -->
            <DataGrid Grid.Row="0" ItemsSource="{Binding Rows}"
                      beh:RowActions.OpenItemCommand="{Binding OpenFicheCommand}"
                      Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"
                      AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True"
                      CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="All"
                      RowHeight="34" FontFamily="{StaticResource AppFont}" FontSize="12.5" Background="{DynamicResource Surface}"
                      RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                      BorderBrush="{DynamicResource Border}" BorderThickness="1"
                      HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}"
                      ColumnHeaderStyle="{StaticResource GridHeader}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Payroll_Employee}" Binding="{Binding Employee}" Width="260">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{loc:Loc Cnas_Col_Issues}" Binding="{Binding Issues}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Margin" Value="10,0,0,0" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusDangerText}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- PART 3 — read-only exposure: exempt allowances with no enforced cap -->
            <Border Grid.Row="1" Margin="0,16,0,8" CornerRadius="10" Padding="16,12"
                    Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    Visibility="{Binding HasExposure, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                               Text="Éléments exonérés sans plafond appliqué  ·  عناصر معفاة دون سقف مطبَّق" />
                    <TextBlock Margin="0,2,0,8" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                               Text="Information (lecture seule) : la part au-dessus d'un plafond légal n'est pas remise dans l'assiette. / معلومة للقراءة فقط: الجزء فوق السقف القانوني لا يُعاد إلى الوعاء." />
                    <ItemsControl ItemsSource="{Binding ExposureRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Element}" FontWeight="SemiBold"
                                               FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12.5"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11.5" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
