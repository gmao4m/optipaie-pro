<Window x:Class="OptiPaie.Desktop.Views.PeriodEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Perf_PeriodEditor}" Height="380" Width="440" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource Brand}" Padding="22,18">
            <TextBlock Text="{loc:Loc Perf_PeriodEditor}" Foreground="{DynamicResource TextOnBrand}" FontSize="17" FontWeight="SemiBold" />
        </Border>

        <StackPanel Grid.Row="1" Margin="22,18">
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_PeriodName}" />
            <TextBox Style="{StaticResource AppTextBox}" Height="36" Margin="0,4,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Cadence}" Margin="0,14,0,0" />
            <ComboBox Style="{StaticResource AppComboBox}" Height="36" Margin="0,4,0,0"
                      ItemsSource="{Binding Cadences}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Cadence}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_StartDate}" />
                    <DatePicker Height="36" Margin="0,4,0,0" SelectedDate="{Binding StartDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_EndDate}" />
                    <DatePicker Height="36" Margin="0,4,0,0" SelectedDate="{Binding EndDate}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc Common_Cancel}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                <Button Content="{loc:Loc Common_Save}" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="120" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
