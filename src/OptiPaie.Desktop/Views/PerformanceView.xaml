<UserControl x:Class="OptiPaie.Desktop.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:OptiPaie.Desktop.Behaviors"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="CenterText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FlowDirection" Value="LeftToRight" />
        </Style>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="PerfGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="RowBackground" Value="{DynamicResource Surface}" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Border}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}" />
        </Style>
        <!-- Semantic pill coloured by the item's BandKind (green good / amber medium / red weak). -->
        <Style x:Key="BandPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BandKind}" Value="success">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusSuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BandKind}" Value="pending">
                    <Setter Property="Background" Value="{DynamicResource StatusPendingSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusPendingText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BandKind}" Value="danger">
                    <Setter Property="Background" Value="{DynamicResource StatusDangerSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusDangerText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Semantic pill coloured by the item's Kind (used by movers + alerts). -->
        <Style x:Key="KindPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource TextSecondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="success">
                    <Setter Property="Background" Value="{DynamicResource StatusSuccessSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusSuccessText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="pending">
                    <Setter Property="Background" Value="{DynamicResource StatusPendingSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusPendingText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="danger">
                    <Setter Property="Background" Value="{DynamicResource StatusDangerSoft}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusDangerText}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="{loc:Loc Perf_Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" Text="{loc:Loc Perf_Subtitle}" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedTabIndex}">

            <!-- ================= TAB 0 — OVERVIEW (control centre) ================= -->
            <TabItem Header="{loc:Loc Perf_Tab_Overview}">
                <Grid DataContext="{Binding Overview}" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- quick actions -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource AccentButton}" Height="36" Margin="8,0,0,0" Content="{loc:Loc Perf_LogBehavior}"
                                            ToolTip="{loc:Loc Perf_LogBehavior_Tip}" Command="{Binding LogBehaviorCommand}" />
                                    <Button Style="{StaticResource PrimaryButton}" Height="36" Margin="8,0,0,0" Content="{loc:Loc Perf_StartEvaluation}"
                                            ToolTip="{loc:Loc Perf_StartEvaluation_Tip}" Command="{Binding StartEvaluationCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding ActivePeriodName}" />
                            </DockPanel>

                            <!-- empty state -->
                            <Border Margin="0,40" HorizontalAlignment="Center" Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" MaxWidth="380">
                                    <TextBlock Text="📋" FontSize="34" HorizontalAlignment="Center" />
                                    <TextBlock Style="{StaticResource EmptyStateMessage}" Margin="0,10,0,12" Text="{loc:Loc Perf_Empty_NoEval}" />
                                    <Button Style="{StaticResource PrimaryButton}" Height="40" HorizontalAlignment="Center" MinWidth="200"
                                            Content="{loc:Loc Perf_NewPeriod}" Command="{Binding NewPeriodCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- KPI tiles -->
                            <UniformGrid Rows="1" Columns="4" Margin="0,14,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_CompanyAverage}" />
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold" FlowDirection="LeftToRight" HorizontalAlignment="Right" Foreground="{DynamicResource BrandText}" Text="{Binding CompanyAvgText}" />
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding CompanyBandLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Best}" />
                                        <TextBlock Text="🏆" FontSize="18" />
                                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}" Text="{Binding BestText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Pending}" />
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource StatusPendingText}" Text="{Binding PendingCount}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_NotEvaluated}" />
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold" Text="{Binding NotEvaluatedCount}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- all clear -->
                            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource StatusSuccessSoft}"
                                    Visibility="{Binding AllClear, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="{DynamicResource StatusSuccessText}" FontWeight="SemiBold" Text="{loc:Loc Perf_AllClear}" />
                            </Border>

                            <!-- alerts to handle -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource StatusDangerText}" Text="{loc:Loc Perf_ToHandle}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,9" Margin="0,0,0,8" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Border}" Background="{DynamicResource Surface}">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="30" MinWidth="90" Content="{loc:Loc Perf_Handle}"
                                                            Command="{Binding DataContext.HandleAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource KindPill}" Margin="0,0,10,0"><TextBlock Style="{StaticResource PillText}" Text="⚠" /></Border>
                                                    <TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- movers -->
                            <Grid Margin="0,16,0,0" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Visibility="{Binding HasImproved, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource StatusSuccessText}" Text="{loc:Loc Perf_Improved}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Improved}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding EmployeeName}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource KindPill}"><TextBlock Style="{StaticResource PillText}"><Run Text="{Binding Arrow, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DeltaText, Mode=OneWay}" /></TextBlock></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding HasDeclined, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource StatusDangerText}" Text="{loc:Loc Perf_Declined}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Declined}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding EmployeeName}" VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Style="{StaticResource KindPill}"><TextBlock Style="{StaticResource PillText}"><Run Text="{Binding Arrow, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DeltaText, Mode=OneWay}" /></TextBlock></Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!-- need support -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasNeedSupport, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_NeedSupport}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding NeedSupport}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding EmployeeName}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" FlowDirection="LeftToRight" Text="{Binding ScoreText}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Style="{StaticResource BandPill}" HorizontalAlignment="Right"><TextBlock Style="{StaticResource PillText}" Text="{Binding BandLabel}" /></Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- recent activity -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_RecentActivity}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Activity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" FlowDirection="LeftToRight" Text="{Binding DateText}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" FontSize="12.5" />
                                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Rectangle Height="20" Fill="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= TAB 1 — EVALUATIONS ================= -->
            <TabItem Header="{loc:Loc Perf_Tab_Evaluations}">
                <Grid DataContext="{Binding Evaluations}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- toolbar -->
                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="34" Margin="8,0,0,0"
                                Content="{loc:Loc Perf_LogBehavior}" Command="{Binding QuickBehaviorCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="34" Margin="8,0,0,0"
                                Content="{loc:Loc Perf_NewPeriod}" Command="{Binding NewPeriodCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{loc:Loc Perf_Period}" />
                            <ComboBox Style="{StaticResource AppComboBox}" Width="230" Height="34"
                                      ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Name" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0"
                                    Content="{Binding PeriodActionLabel}" Command="{Binding TogglePeriodCommand}" />
                            <Button Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0"
                                    Content="{loc:Loc Common_Delete}" Command="{Binding DeletePeriodCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- best of period -->
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                            Background="{DynamicResource AccentSoft}" Visibility="{Binding HasBest, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold">
                                <Run Text="{loc:Loc Perf_BestOfPeriod}" /><Run Text="  " /><Run Text="{Binding BestText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- board -->
                    <DataGrid x:Name="BoardGrid" Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource PerfGrid}" ItemsSource="{Binding Board}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Perf_Col_Employee}" Binding="{Binding EmployeeName}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Perf_Col_Dept}" Binding="{Binding Department}" Width="170" />
                            <DataGridTextColumn Header="{loc:Loc Perf_Score}" Binding="{Binding ScoreText}" Width="110" ElementStyle="{StaticResource CenterText}" />
                            <DataGridTemplateColumn Header="{loc:Loc Perf_Rating}" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BandPill}" HorizontalAlignment="Center" Visibility="{Binding IsEvaluated, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource PillText}" Text="{Binding BandLabel}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{loc:Loc Common_Status}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}">
                                            <TextBlock Style="{StaticResource PillText}" Text="{Binding StatusLabel}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="215" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="👍" Style="{StaticResource RowIconButton}" ToolTip="{loc:Loc Perf_BehaviorPositive}"
                                                    Command="{Binding DataContext.QuickPositiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Content="👎" Style="{StaticResource RowIconButton}" ToolTip="{loc:Loc Perf_BehaviorNegative}"
                                                    Command="{Binding DataContext.QuickNegativeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource SecondaryButton}" Height="28" Margin="6,0,0,0" MinWidth="90" Content="{Binding ActionLabel}"
                                                    Command="{Binding DataContext.EvaluateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,18,0,0" Style="{StaticResource EmptyStateMessage}" Text="{loc:Loc Perf_NoPeriod}"
                               Visibility="{Binding HasItems, ElementName=BoardGrid, Converter={StaticResource InverseBoolToVis}}" />

                    <TextBlock Grid.Row="3" Margin="0,12" Style="{StaticResource Caption}" FlowDirection="LeftToRight"
                               HorizontalAlignment="Left" Text="{Binding StatusMessage}" />
                </Grid>
            </TabItem>

            <!-- ================= TAB 2 — TEMPLATES ================= -->
            <TabItem Header="{loc:Loc Perf_Tab_Templates}">
                <Grid DataContext="{Binding Templates}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="34"
                                Content="{loc:Loc Perf_NewTemplate}" Command="{Binding NewCommand}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{loc:Loc Perf_Templates_Hint}" />
                    </DockPanel>

                    <DataGrid x:Name="TemplatesGrid" Grid.Row="1" Margin="0,12,0,0" Style="{StaticResource PerfGrid}"
                              ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Perf_Col_Template}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Perf_Col_Dept}" Binding="{Binding Department}" Width="180" />
                            <DataGridTextColumn Header="{loc:Loc Perf_Col_Mode}" Binding="{Binding ModeLabel}" Width="150" />
                            <DataGridTextColumn Header="{loc:Loc Perf_Col_Criteria}" Binding="{Binding CountText}" Width="90" ElementStyle="{StaticResource CenterText}" />
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusPill}" Visibility="{Binding HasTag, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource PillText}" Text="{Binding TagLabel}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="60" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource RowIconButton}" Content="⋯" HorizontalAlignment="Right"
                                                beh:RowActions.SelectRow="True" beh:RowActions.OpenMenuOnClick="True"
                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                            <Button.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="{loc:Loc Common_Edit}" Command="{Binding EditCommand}" />
                                                    <MenuItem Header="{loc:Loc Perf_Duplicate}" Command="{Binding DuplicateCommand}" />
                                                    <MenuItem Header="{loc:Loc Perf_SetDefault}" Command="{Binding SetDefaultCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{loc:Loc Common_Delete}" Command="{Binding DeleteCommand}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ================= TAB 3 — REPORTS ================= -->
            <TabItem Header="{loc:Loc Perf_Tab_Reports}">
                <Grid DataContext="{Binding Reports}" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0"
                                Content="{loc:Loc Perf_ExportCsv}" Command="{Binding ExportCsvCommand}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0"
                                Content="{loc:Loc Perf_ExportPdf}" Command="{Binding ExportPdfCommand}" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox Style="{StaticResource AppComboBox}" Width="180" Height="34" SelectedIndex="{Binding Mode}">
                                <ComboBoxItem Content="{loc:Loc Perf_Report_General}" />
                                <ComboBoxItem Content="{loc:Loc Perf_Report_Dept}" />
                                <ComboBoxItem Content="{loc:Loc Perf_Report_Employee}" />
                            </ComboBox>
                            <ComboBox Style="{StaticResource AppComboBox}" Width="200" Height="34" Margin="8,0,0,0"
                                      ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}"
                                      Visibility="{Binding IsDept, Converter={StaticResource BoolToVis}}" />
                            <ComboBox Style="{StaticResource AppComboBox}" Width="220" Height="34" Margin="8,0,0,0"
                                      ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name"
                                      Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="{Binding Headline}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding Subline}" />

                            <!-- scalar tiles -->
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Border Style="{StaticResource Tile}" Visibility="{Binding IsEmployee, Converter={StaticResource InverseBoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Average}" />
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" Text="{Binding CompanyAvgText}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Score}" />
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}">
                                            <Run Text="{Binding EmpScoreText, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding EmpBandText, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Tile}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_Behavior}" />
                                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="SemiBold" Text="{Binding EmpBehaviorText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- recommendation (employee) -->
                            <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource BrandSoft}"
                                    Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVis}}">
                                <TextBlock Foreground="{DynamicResource BrandText}" TextWrapping="Wrap">
                                    <Run Text="{loc:Loc Perf_Recommendation}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding EmpRecommendation, Mode=OneWay}" />
                                </TextBlock>
                            </Border>

                            <!-- best (general) -->
                            <TextBlock Margin="0,14,0,4" Style="{StaticResource Caption}" Text="{Binding BestText}"
                                       Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}" />

                            <!-- department averages (general) -->
                            <TextBlock Margin="0,14,0,6" Style="{StaticResource Caption}" Text="{loc:Loc Perf_DeptAverages}"
                                       Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding DeptAverages}" Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Department}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" TextAlignment="Center" Text="{Binding EmployeeCount}" />
                                                <TextBlock Grid.Column="2" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding AverageScore}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ranking / top performers -->
                            <TextBlock Margin="0,16,0,6" Style="{StaticResource Caption}" Text="{loc:Loc Perf_Ranking}"
                                       Visibility="{Binding IsEmployee, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding TopRows}" Visibility="{Binding IsEmployee, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="{StaticResource MonoFont}" Text="{Binding Rank}" />
                                                <TextBlock Grid.Column="1" Text="{Binding EmployeeName}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondary}" Text="{Binding Department}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" FlowDirection="LeftToRight" FontWeight="SemiBold" Text="{Binding ScoreText}" />
                                                <Border Grid.Column="4" Style="{StaticResource BandPill}" HorizontalAlignment="Right"><TextBlock Style="{StaticResource PillText}" Text="{Binding BandLabel}" /></Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- need support -->
                            <TextBlock Margin="0,16,0,6" Style="{StaticResource Caption}" Foreground="{DynamicResource StatusDangerText}" Text="{loc:Loc Perf_NeedSupport}"
                                       Visibility="{Binding IsEmployee, Converter={StaticResource InverseBoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding SupportRows}" Visibility="{Binding IsEmployee, Converter={StaticResource InverseBoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,5" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding EmployeeName}" />
                                                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" FlowDirection="LeftToRight" Text="{Binding ScoreText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- strengths / weaknesses (employee) -->
                            <Grid Margin="0,16,0,0" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource StatusSuccessText}" Text="{loc:Loc Perf_Strengths}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding StrengthRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" /><TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" Text="{Binding Score}" /></Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource StatusDangerText}" Text="{loc:Loc Perf_Weaknesses}" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding WeaknessRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" /><TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" Text="{Binding Score}" /></Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>

                            <!-- trend -->
                            <TextBlock Margin="0,16,0,6" Style="{StaticResource Caption}" Text="{loc:Loc Perf_Trend}" />
                            <ItemsControl ItemsSource="{Binding TrendRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,5" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="200" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PeriodName}" VerticalAlignment="Center" />
                                                <ProgressBar Grid.Column="1" Height="8" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="{Binding Score, Mode=OneWay}"
                                                             Background="{DynamicResource SurfaceMuted}" Foreground="{DynamicResource BrandText}" BorderThickness="0" />
                                                <TextBlock Grid.Column="2" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" FontWeight="SemiBold" Text="{Binding Score}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Rectangle Height="20" Fill="Transparent" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
