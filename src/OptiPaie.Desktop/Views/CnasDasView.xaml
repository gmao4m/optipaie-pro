<UserControl x:Class="OptiPaie.Desktop.Views.CnasDasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <!-- A clickable "open the fiche" row, with a › affordance. -->
        <Style x:Key="ClickableRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,7">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="›" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,4,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: subtitle + year + generate -->
        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="620" Text="{loc:Loc Cnas_Das_Subtitle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox Style="{StaticResource AppComboBox}" Width="100" Height="34"
                          ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                <Button Style="{StaticResource PrimaryButton}" Height="34" Margin="10,0,0,0"
                        Content="{loc:Loc Cnas_Das_Generate}" Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding HasCompany}" />
            </StackPanel>
        </Grid>

        <!-- Permanent banner + no-company + estimation warning -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <Border Background="{DynamicResource StatusPendingSoft}" CornerRadius="10" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource StatusPendingText}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusPendingText}" Text="{loc:Loc Cnas_Das_Banner}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="16,12" Margin="0,10,0,0"
                    Visibility="{Binding HasCompany, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_NoCompany}" />
            </Border>

            <!-- Durée estimée — NOMINATIVE, cliquable -->
            <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="16,12" Margin="0,10,0,0"
                    Visibility="{Binding HasEstimatedDurations, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Cnas_Das_EstimatedTitle}" />
                    <ItemsControl ItemsSource="{Binding EstimatedEmployees}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ClickableRow}" Content="{Binding Name}"
                                        Command="{Binding DataContext.OpenFicheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Dynamic: refusal OR success -->
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- Refusal: grouped by problem type, clickable -->
                <Border Background="{DynamicResource StatusDangerSoft}" CornerRadius="10" Padding="18,14"
                        Visibility="{Binding HasRefusal, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource StatusDangerText}" Text="{Binding RefusalHeadline}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{loc:Loc Cnas_Das_RefusalHint}" />

                        <!-- Plafond de montant : ce n'est pas un bug — on l'explique et on invite au contact. -->
                        <Border Background="{DynamicResource Surface}" CornerRadius="8" Padding="14,11" Margin="0,10,0,0"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                Visibility="{Binding HasAmountCapBlocker, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="15" VerticalAlignment="Top" Margin="0,1,10,0" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="840" Text="{loc:Loc Cnas_Das_CapExplain}" />
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding BlockerGroups}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap">
                                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="6,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ClickableRow}" Content="{Binding Name}"
                                                            Command="{Binding DataContext.OpenFicheCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Success: recap the accountant checks before depositing -->
                <Border Style="{StaticResource Card}" Padding="18,16"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessText}" />
                            <TextBlock Margin="10,0,0,0" Style="{StaticResource H2}" FontSize="14" VerticalAlignment="Center" Text="{loc:Loc Cnas_Das_SuccessTitle}" />
                        </StackPanel>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,0,24,6" Text="{loc:Loc Cnas_Das_RecapYear}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding ResultYear}" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,0,24,6" Text="{loc:Loc Cnas_Das_RecapEffectif}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding ResultEffectif}" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,0,24,6" Text="{loc:Loc Cnas_Das_RecapAnnual}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding ResultAnnual}" />
                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Caption}" Margin="0,0,24,0" Text="{loc:Loc Cnas_Das_RecapQuarters}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Text="{Binding ResultQuarters}" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,14" />
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_Das_FilesWritten}" />
                        <TextBlock Margin="0,3,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Text="{Binding ResultFiles}" />
                        <Button Style="{StaticResource SecondaryButton}" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0"
                                Content="{loc:Loc Cnas_Das_OpenFolder}" Command="{Binding OpenFolderCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
