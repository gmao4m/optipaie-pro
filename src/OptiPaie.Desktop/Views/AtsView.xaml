<UserControl x:Class="OptiPaie.Desktop.Views.AtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
             Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <!-- One small pill style, coloured by the semantic "kind" string. -->
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKind}" Value="success">
                    <Setter Property="Background" Value="{DynamicResource GainSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKind}" Value="accent">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StageKind}" Value="success">
                    <Setter Property="Background" Value="{DynamicResource GainSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StageKind}" Value="accent">
                    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="{loc:Loc Recruit_Title}" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Postings (start side) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Recruit_Postings}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Height="34" Padding="14,0"
                                Content="{loc:Loc Recruit_AddPosting}" Command="{Binding NewPostingCommand}" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Postings}" SelectedItem="{Binding SelectedPosting}"
                             Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,3" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="12,10"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Loc Common_Edit}"
                                                      Command="{Binding PlacementTarget.Tag.EditPostingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{loc:Loc Recruit_ToggleOpen}"
                                                      Command="{Binding PlacementTarget.Tag.TogglePostingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{loc:Loc Common_Delete}"
                                                      Command="{Binding PlacementTarget.Tag.DeletePostingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Department}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource Pill}">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                                            </Border>
                                            <TextBlock Text="{Binding CountText}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                            <TextBlock Text="{loc:Loc Recruit_CandidatesShort}" Margin="4,0,0,0" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Candidates of the selected posting -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Recruit_Candidates}" />
                            <TextBlock Text="{Binding CandidatesHeader}" FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="34" Padding="14,0"
                                Content="{loc:Loc Recruit_AddCandidate}" Command="{Binding NewCandidateCommand}"
                                IsEnabled="{Binding HasSelectedPosting}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Candidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface}" CornerRadius="10" Padding="14,12" Margin="0,3"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1" Cursor="Hand"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Loc Recruit_Back}"
                                                          Command="{Binding PlacementTarget.Tag.BackStepCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc Recruit_Reject}"
                                                          Command="{Binding PlacementTarget.Tag.RejectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{loc:Loc Recruit_Desist}"
                                                          Command="{Binding PlacementTarget.Tag.DesistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="{loc:Loc Common_Delete}"
                                                          Command="{Binding PlacementTarget.Tag.DeleteCandidateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,6" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource Pill}">
                                                        <TextBlock Text="{Binding StageLabel}" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding ClosureLabel}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMuted}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" VerticalAlignment="Center" Height="34" Padding="14,0"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Content="{Binding NextActionLabel}"
                                                    Visibility="{Binding ShowNextAction, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.NextStepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="2,10,2,0" Text="{Binding StatusMessage}" />
    </Grid>
</UserControl>
