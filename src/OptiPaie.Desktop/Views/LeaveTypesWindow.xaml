<Window x:Class="OptiPaie.Desktop.Views.LeaveTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc LeaveTypes_Title}" Height="580" Width="860"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H2}" Text="{loc:Loc LeaveTypes_Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Loc LeaveTypes_Hint}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="All" RowHeight="30" FontSize="12.5"
                      Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}"
                      AlternatingRowBackground="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                      HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc LeaveTypes_Label}" Binding="{Binding LabelAr}" Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Common_Type}" Binding="{Binding BaseLabel}" Width="120" />
                    <DataGridTextColumn Header="{loc:Loc Leave_ColPayment}" Binding="{Binding PaymentLabel}" Width="130" />
                    <DataGridTextColumn Header="{loc:Loc Leave_ColBalance}" Binding="{Binding DecrementsLabel}" Width="120" />
                    <DataGridTextColumn Header="{loc:Loc LeaveTypes_Duration}" Binding="{Binding DurationText}" Width="70" />
                    <DataGridCheckBoxColumn Header="{loc:Loc LeaveTypes_Active}" Binding="{Binding IsActive}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc LeaveTypes_LabelAr}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding EditLabelAr, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{loc:Loc LeaveTypes_LabelFr}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding EditLabelFr, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{loc:Loc LeaveTypes_BaseType}" />
                <ComboBox Style="{StaticResource AppComboBox}" Height="32" Margin="0,4,0,0" ItemsSource="{Binding BaseTypes}" SelectedItem="{Binding EditBaseType}" DisplayMemberPath="Label" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{loc:Loc LeaveTypes_Payment}" />
                <ComboBox Style="{StaticResource AppComboBox}" Height="32" Margin="0,4,0,0" ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}" DisplayMemberPath="Label" />
                <CheckBox Margin="0,12,0,0" IsChecked="{Binding EditDecrements}" Content="{loc:Loc LeaveTypes_Decrements}" />
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding EditOnce}" Content="{loc:Loc LeaveTypes_Once}" />
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding EditActive}" Content="{loc:Loc LeaveTypes_Active}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{loc:Loc LeaveTypes_Duration}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding EditLegalDuration, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc LeaveTypes_New}" Command="{Binding NewCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" />
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                        Content="{loc:Loc LeaveTypes_Deactivate}" Command="{Binding DeactivateCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
