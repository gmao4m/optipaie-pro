<Window x:Class="OptiPaie.Desktop.Views.RetirementListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{Binding Title}" Height="540" Width="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding CountText}" />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="{loc:Loc Workforce_Retirement_Empty}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal" Background="Transparent" BorderThickness="0"
                          RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                          HorizontalGridLinesBrush="{DynamicResource Border}" FontSize="12.5"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Payroll_Employee}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Workforce_Col_BirthDate}" Binding="{Binding BirthDate}" Width="120" />
                        <DataGridTextColumn Header="{loc:Loc Workforce_Col_Age}" Binding="{Binding Age}" Width="80" />
                        <DataGridTextColumn Header="{loc:Loc Workforce_Col_RetirementDate}" Binding="{Binding RetirementDate}" Width="130" />
                        <DataGridTextColumn Header="{loc:Loc Workforce_Col_RetirementStatus}" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Button Grid.Row="2" HorizontalAlignment="Right" Margin="0,14,0,0" Style="{StaticResource SecondaryButton}"
                Height="34" Padding="16,0" Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" />
    </Grid>
</Window>
