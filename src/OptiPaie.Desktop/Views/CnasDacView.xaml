<UserControl x:Class="OptiPaie.Desktop.Views.CnasDacView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:beh="clr-namespace:OptiPaie.Desktop.Behaviors"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <!-- Small copy button (clipboard icon) — so a figure is never selected by hand. -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                            <Path Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource TextSecondary}" Data="{StaticResource IconClipboard}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceMuted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FigureValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,4,2,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: subtitle + selectors -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_Dac_Subtitle}" />
                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextPrimary}" Text="{Binding PeriodLabel}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"
                        Content="{loc:Loc Common_ExportPdf}" Command="{Binding ExportPdfCommand}" />
                <ComboBox Style="{StaticResource AppComboBox}" Width="90" Height="32"
                          ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" />
                <ComboBox Style="{StaticResource AppComboBox}" Width="150" Height="32" Margin="8,0,0,0"
                          ItemsSource="{Binding Cadences}" SelectedItem="{Binding SelectedCadence}" DisplayMemberPath="Label" />
                <ComboBox Style="{StaticResource AppComboBox}" Width="130" Height="32" Margin="8,0,0,0"
                          ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding CadenceInfo}"
                       Visibility="{Binding CadenceInfo, Converter={StaticResource NonEmptyToVis}}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{loc:Loc Cnas_Dac_PortalNote}" />
            <Border Background="{DynamicResource StatusDangerSoft}" CornerRadius="10" Padding="14,10" Margin="0,8,0,0"
                    Visibility="{Binding EmployerNumberIssue, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusDangerText}" Text="{Binding EmployerMessage}" />
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <!-- No payslips for the period -->
                <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="16,12"
                        Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding StatusMessage}" />
                </Border>

                <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                    <!-- Identity line -->
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_Dac_Employer}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="15" Text="{Binding EmployerNumber}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="6,0,0,0" beh:CopyBehavior.Text="{Binding EmployerNumberCopy}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_Dac_Effectif}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="15" Text="{Binding Effectif}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="6,0,0,0" beh:CopyBehavior.Text="{Binding EffectifCopy}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Assiette + cotisations appliquées -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{loc:Loc Cnas_Dac_Applied}" />
                            <!-- Assiette -->
                            <Grid Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Cnas_Dac_Assiette}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="20" Text="{Binding Assiette}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="8,0,0,0" beh:CopyBehavior.Text="{Binding AssietteCopy}" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,12" />
                            <!-- Salariale -->
                            <Grid Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Text="{loc:Loc Cnas_Dac_Salariale}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource BrandSoft}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" Text="{Binding SalarialeRate}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="14" Text="{Binding Salariale}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="8,0,0,0" beh:CopyBehavior.Text="{Binding SalarialeCopy}" />
                                </StackPanel>
                            </Grid>
                            <!-- Contrôle discret « déclaré vs retenu » (visible seulement si écart non nul) -->
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,1,36,0"
                                       Visibility="{Binding HasSalarialeWithholdingGap, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding SalarialeWithheldLine}" />
                            <!-- Patronale -->
                            <Grid Margin="0,6,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Text="{loc:Loc Cnas_Dac_Patronale}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource BrandSoft}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" Text="{Binding PatronaleRate}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="14" Text="{Binding Patronale}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="8,0,0,0" beh:CopyBehavior.Text="{Binding PatronaleCopy}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" TextAlignment="Right" Margin="0,1,36,0"
                                       Visibility="{Binding HasPatronaleWithholdingGap, Converter={StaticResource BoolToVis}}"
                                       Text="{Binding PatronaleWithheldLine}" />
                            <Border Height="1" Background="{DynamicResource Border}" Margin="0,10" />
                            <!-- Total -->
                            <Grid>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{loc:Loc Cnas_Dac_Total}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="16" Text="{Binding Total}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="8,0,0,0" beh:CopyBehavior.Text="{Binding TotalCopy}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Contrôle de cohérence : l'écart de taux (information, arbitrage parqué — pas une alerte) -->
                    <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="18,14" Margin="0,12,0,0"
                            Visibility="{Binding HasGap, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{loc:Loc Cnas_Dac_GapTitle}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap" Text="{loc:Loc Cnas_Dac_GapHint}" />
                            <Grid Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource TextPrimary}" Text="{loc:Loc Cnas_Dac_OfficialPatronale}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Surface}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding OfficialPatronaleRate}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="14" Text="{Binding OfficialPatronale}" />
                                    <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Margin="8,0,0,0" beh:CopyBehavior.Text="{Binding OfficialPatronaleCopy}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{loc:Loc Cnas_Dac_Gap}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource FigureValue}" FontSize="14" Foreground="{DynamicResource TextPrimary}" Text="{Binding GapDa}" />
                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="10,0,0,0" VerticalAlignment="Center" Text="·" />
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding GapPoints}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Répartition officielle (décret 94-187) — à confirmer -->
                    <TextBlock Style="{StaticResource Caption}" Margin="2,16,0,6" Text="{loc:Loc Cnas_Dac_OfficialTitle}" />
                    <DataGrid ItemsSource="{Binding Branches}" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True"
                              CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="All" RowHeight="32"
                              FontFamily="{StaticResource AppFont}" FontSize="12" Background="{DynamicResource Surface}"
                              RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                              BorderBrush="{DynamicResource Border}" BorderThickness="1"
                              HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}"
                              ColumnHeaderStyle="{StaticResource GridHeader}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Cnas_Dac_Branch}" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="10,0,0,0" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{loc:Loc Cnas_Dac_PatRate}" Binding="{Binding PatronaleRate}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{loc:Loc Cnas_Dac_PatAmount}" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                            <TextBlock Style="{StaticResource FigureValue}" FontSize="12" Text="{Binding PatronaleAmount}" />
                                            <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Width="24" Height="24" Margin="4,0,0,0" beh:CopyBehavior.Text="{Binding PatronaleCopy}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:Loc Cnas_Dac_SalRate}" Binding="{Binding SalarialeRate}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="{loc:Loc Cnas_Dac_SalAmount}" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                                            <TextBlock Style="{StaticResource FigureValue}" FontSize="12" Text="{Binding SalarialeAmount}" />
                                            <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Width="24" Height="24" Margin="4,0,0,0" beh:CopyBehavior.Text="{Binding SalarialeCopy}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rounding-robustness notice: surfaced, never absorbed into a branch. -->
                    <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="10" Padding="14,10" Margin="0,10,0,0"
                            Visibility="{Binding HasRoundingWarning, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource StatusPendingSoft}" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="!" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource StatusPendingText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="720"
                                       VerticalAlignment="Center" Text="{Binding RoundingWarning}" />
                        </StackPanel>
                    </Border>

                    <!-- Annexe mouvements de la période (entrées/sorties) — clic sur une ligne = fiche -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding HasMovements, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource H2}" FontSize="14" Text="{loc:Loc Cnas_Dac_Movements}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,8" Text="{loc:Loc Cnas_Dac_MovementsHint}" />
                        <DataGrid ItemsSource="{Binding Movements}" beh:RowActions.OpenItemCommand="{Binding OpenFicheCommand}"
                                  AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="All" RowHeight="34"
                                  FontFamily="{StaticResource AppFont}" FontSize="12" Background="{DynamicResource Surface}"
                                  RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                                  BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                  HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{loc:Loc Cnas_Mov_Type}" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,2" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource SurfaceMuted}">
                                                <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding TypeLabel}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Payroll_Employee}" Binding="{Binding Name}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="10,0,0,0" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="{loc:Loc Cnas_Mov_Nss}" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource FigureValue}" FontSize="12" Text="{Binding Nss}" />
                                                <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Width="24" Height="24" Margin="6,0,0,0" beh:CopyBehavior.Text="{Binding NssCopy}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="{loc:Loc Cnas_Mov_Date}" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                                <TextBlock Style="{StaticResource FigureValue}" FontSize="12" Text="{Binding DateText}" />
                                                <Button Style="{StaticResource CopyButton}" ToolTip="{loc:Loc Common_Copy}" Width="24" Height="24" Margin="6,0,0,0" beh:CopyBehavior.Text="{Binding DateCopy}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
