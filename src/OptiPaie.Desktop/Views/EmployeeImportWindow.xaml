<Window x:Class="OptiPaie.Desktop.Views.EmployeeImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Width="760" Height="680" ResizeMode="CanResize" MinWidth="620" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Subtitle}" />
            <TextBlock Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Text="{Binding FileName}" />
        </StackPanel>

        <!-- Mapping: our field (left) ↔ your column (right) -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" Text="{loc:Loc Import_OurField}" />
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Right" Text="{loc:Loc Import_YourColumn}" />
                </Grid>
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mapping}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="260" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Text=" *" Foreground="{DynamicResource Deduction}" VerticalAlignment="Center"
                                                   Visibility="{Binding Required, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{StaticResource AppComboBox}" Height="30"
                                              ItemsSource="{Binding Available}" SelectedItem="{Binding SelectedHeader, Mode=TwoWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Height="32"
                        Content="{loc:Loc Import_Recheck}" Command="{Binding RecheckCommand}" />
            </StackPanel>
        </Border>

        <!-- Preview: summary + per-row/column problems -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" FontWeight="SemiBold" Text="{Binding SummaryText}" />

                <!-- Required column(s) not mapped -->
                <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource StatusDangerSoft}"
                        Visibility="{Binding HasUnmappedRequired, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UnmappedRequiredText}" TextWrapping="Wrap"
                               Foreground="{DynamicResource StatusDangerText}" FontSize="12" />
                </Border>

                <Border Grid.Row="2" Margin="0,10,0,0"
                        Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StatusDangerText}">
                                        <Run Text="{loc:Loc Import_RowWord}" /><Run Text=" " /><Run Text="{Binding RowNumber, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" · " /><Run Text="{Binding Column, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  —  " /><Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Duplicate handling -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0" Visibility="{Binding HasDuplicates, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Import_DupTitle}" Margin="0,0,0,4" />
            <RadioButton Content="{loc:Loc Import_DupSkip}" IsChecked="{Binding SkipDuplicates, Mode=TwoWay}"
                         Foreground="{DynamicResource TextPrimary}" Margin="0,2" />
            <RadioButton Content="{loc:Loc Import_DupStop}" IsChecked="{Binding StopOnDuplicates, Mode=TwoWay}"
                         Foreground="{DynamicResource TextPrimary}" Margin="0,2" />
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                    Height="38" MinWidth="110" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="{loc:Loc Import_DoImport}" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}"
                    Height="38" MinWidth="150" IsDefault="True" IsEnabled="{Binding CanConfirm}" />
        </StackPanel>
    </Grid>
</Window>
