<Window x:Class="OptiPaie.Desktop.Views.PayslipCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Width="760" Height="640" ResizeMode="CanResize" MinWidth="640" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Subtitle}" />
            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold">
                <Run Text="{Binding EmployeeName, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PeriodText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- CNAS declaration warning (only when a DAC/DAS already exists for the period) -->
        <Border Grid.Row="1" Margin="0,14,0,0" Padding="12,10" CornerRadius="8"
                Background="{DynamicResource StatusPendingSoft}" BorderBrush="{DynamicResource StatusPendingText}" BorderThickness="1"
                Visibility="{Binding HasDeclarationWarning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding DeclarationWarning}" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusPendingText}" FontSize="12" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      GridLinesVisibility="All" SelectionUnit="Cell" SelectionMode="Single"
                      Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                      HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc Payroll_Col_Label}" Binding="{Binding Rubrique}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:Loc Payroll_Col_Base}" Width="130"
                                        Binding="{Binding Base, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="{loc:Loc Payroll_Col_Rate}" Width="100"
                                        Binding="{Binding Taux, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="{loc:Loc Payroll_Col_Gain}" Binding="{Binding Gain, StringFormat=N2}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="{loc:Loc Payroll_Col_Deduction}" Binding="{Binding Retenue, StringFormat=N2}" Width="130" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Old vs new net -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding OldNetLabel}" />
                    <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Text="{Binding OldNetText}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,10" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding NewNetLabel}" />
                    <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Salary}" Text="{Binding NewNetText}" />
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding ReasonLabel}" Margin="0,0,0,6" />
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MinHeight="54" MaxHeight="110"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                     Padding="10,7" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                     Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
            <TextBlock Margin="2,6,0,0" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusDangerText}" Text="{Binding Status}" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}"
                    Height="38" MinWidth="110" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="{Binding SaveLabel}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                    Height="38" MinWidth="170" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
