<Window x:Class="OptiPaie.Desktop.Views.DemoRemovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Demo_Preview_Title}"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- Preview before the trial demo company is removed. Cancel is the default; Delete is disabled when the
         demo is the only company. The service re-identifies the demo and backs up first, whatever this shows. -->
    <StackPanel Margin="24,22">
        <TextBlock Text="{loc:Loc Demo_Preview_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding CompanyName}" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding MatchedText}" Margin="0,2,0,0" FontSize="12.5"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

        <TextBlock Text="{loc:Loc Demo_Preview_Intro}" Margin="0,14,0,6" FontSize="13.5"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource Surface}">
            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows}" Margin="12,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="13" FontWeight="SemiBold"
                                           Margin="16,0,0,0" Foreground="{DynamicResource TextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <TextBlock Text="{Binding TotalText}" Margin="0,8,0,0" FontSize="13.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />

        <TextBlock Text="{loc:Loc Demo_Preview_Backup}" Margin="0,12,0,0" FontSize="12.5"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

        <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource StatusDangerSoft}"
                Visibility="{Binding IsOnlyCompany, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc Demo_Preview_OnlyCompany}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusDangerText}" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc Common_Cancel}" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"
                    Height="38" MinWidth="96" Margin="0,0,10,0" IsCancel="True" IsDefault="True" />
            <Button x:Name="DeleteButton" Content="{loc:Loc Demo_Preview_Delete}" Click="Ok_Click"
                    Style="{StaticResource DangerButton}" Height="38" MinWidth="150"
                    IsEnabled="{Binding CanDelete}" />
        </StackPanel>
    </StackPanel>
</Window>
