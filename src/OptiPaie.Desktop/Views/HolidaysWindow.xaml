<Window x:Class="OptiPaie.Desktop.Views.HolidaysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Holidays_Title}" Height="540" Width="660"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Holidays_Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="420" Text="{loc:Loc Holidays_Hint}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <ComboBox Style="{StaticResource AppComboBox}" Width="90" Height="32" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
                <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="8,0,0,0" Content="{loc:Loc Holidays_Prefill}" Command="{Binding PrefillCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <DatePicker Height="32" Width="150" SelectedDate="{Binding NewDate}" FlowDirection="LeftToRight" />
            <TextBox Style="{StaticResource AppTextBox}" Width="250" Height="32" Margin="8,0,0,0"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox VerticalAlignment="Center" Margin="12,0,0,0" IsChecked="{Binding NewReligious}" Content="{loc:Loc Holidays_Religious}" />
            <Button Style="{StaticResource PrimaryButton}" Height="32" Margin="12,0,0,0" Content="{loc:Loc Holidays_Add}" Command="{Binding AddCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="2" Margin="0,14,0,0" ItemsSource="{Binding Holidays}" SelectedItem="{Binding SelectedHoliday}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False"
                  GridLinesVisibility="All" RowHeight="30" FontSize="12.5" Background="{DynamicResource Surface}"
                  RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Holidays_Date}" Binding="{Binding HolidayDate, StringFormat=dd/MM/yyyy}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:Loc Holidays_Name}" Binding="{Binding NameAr}" Width="*" />
                <DataGridCheckBoxColumn Header="{loc:Loc Holidays_Religious}" Binding="{Binding IsReligious}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common_Delete}" Command="{Binding DeleteCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
