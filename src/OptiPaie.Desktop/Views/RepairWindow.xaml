<Window x:Class="OptiPaie.Desktop.Views.RepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiPaie PRO" Height="250" Width="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Border Style="{StaticResource Card}" Width="374" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brand}" HorizontalAlignment="Center">
                    <TextBlock Text="&#x1F527;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" HorizontalAlignment="Center" Margin="0,14,0,0"
                           FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="BodyText" HorizontalAlignment="Center" Margin="0,8,0,0"
                           FontSize="13" Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="ActionButton" Style="{StaticResource PrimaryButton}" Margin="0,20,0,0"
                        Click="ActionButton_Click" MinWidth="140" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
