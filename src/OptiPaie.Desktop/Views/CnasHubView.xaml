<UserControl x:Class="OptiPaie.Desktop.Views.CnasHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptiPaie.Desktop.Views"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <TabControl Margin="24,16,24,0" Background="Transparent" BorderThickness="0">
        <TabItem Header="{loc:Loc Cnas_Tab_Readiness}">
            <views:CnasReadinessView DataContext="{Binding Readiness}" Margin="0,8,0,0" />
        </TabItem>
        <TabItem Header="{loc:Loc Cnas_Tab_Dac}">
            <views:CnasDacView DataContext="{Binding Dac}" Margin="0,8,0,0" />
        </TabItem>
        <TabItem Header="{loc:Loc Cnas_Tab_Das}">
            <views:CnasDasView DataContext="{Binding Das}" Margin="0,8,0,0" />
        </TabItem>
    </TabControl>
</UserControl>
