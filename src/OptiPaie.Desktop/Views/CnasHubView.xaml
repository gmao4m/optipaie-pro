<UserControl x:Class="OptiPaie.Desktop.Views.CnasHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OptiPaie.Desktop.Views"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <Grid>
        <!-- Legal deductions switched OFF: a clear notice INSTEAD of the declarations, never a
             declaration full of zeros. -->
        <Border Margin="24,24,24,0" VerticalAlignment="Top" Padding="20,16" CornerRadius="10"
                Background="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Warning}" BorderThickness="1.5"
                Visibility="{Binding LegalDeductionsDisabled, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{loc:Loc Legal_DeclDisabled_Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Warning}" TextWrapping="Wrap" />
                <TextBlock Text="{loc:Loc Legal_DeclDisabled_Body}" Margin="0,6,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TabControl Margin="24,16,24,0" Background="Transparent" BorderThickness="0"
                    Visibility="{Binding LegalDeductionsDisabled, Converter={StaticResource InverseBoolToVis}}">
            <TabItem Header="{loc:Loc Cnas_Tab_Readiness}">
                <views:CnasReadinessView DataContext="{Binding Readiness}" Margin="0,8,0,0" />
            </TabItem>
            <TabItem Header="{loc:Loc Cnas_Tab_Dac}">
                <views:CnasDacView DataContext="{Binding Dac}" Margin="0,8,0,0" />
            </TabItem>
            <TabItem Header="{loc:Loc Cnas_Tab_Das}">
                <views:CnasDasView DataContext="{Binding Das}" Margin="0,8,0,0" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
