<Window x:Class="OptiPaie.Desktop.Views.LegalDeductionsConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Legal_Confirm_Title}"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- Shown ONLY when switching the legal deductions OFF. Turning them back ON needs no confirmation. -->
    <StackPanel Margin="24,22">
        <TextBlock Text="{loc:Loc Legal_Confirm_Title}" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc Legal_Confirm_Line1}" Margin="0,12,0,0" FontSize="13.5"
                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Loc Legal_Confirm_Line2}" Margin="0,4,0,0" FontSize="13.5"
                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{loc:Loc Common_Cancel}" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"
                    Height="38" MinWidth="96" Margin="0,0,10,0" IsCancel="True" IsDefault="True" />
            <Button Content="{loc:Loc Legal_Confirm_Ok}" Click="Ok_Click" Style="{StaticResource PrimaryButton}"
                    Height="38" MinWidth="120" />
        </StackPanel>
    </StackPanel>
</Window>
