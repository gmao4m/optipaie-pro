<Window x:Class="OptiPaie.Desktop.Views.PayslipHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Width="680" Height="560" ResizeMode="CanResize" MinWidth="560" MinHeight="420"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Title="{Binding Title}"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H1}" Text="{Binding Title}" Margin="0,0,0,14" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <ListBox ItemsSource="{Binding Rows}" BorderThickness="0" Background="Transparent"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="8,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="Transparent" CornerRadius="8" Padding="12,10">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding EmployeeName}" />
                                        <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource TextMuted}" Text="{Binding PeriodText}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Padding="7,2" CornerRadius="6" Background="{DynamicResource StatusPill}">
                                            <TextBlock FontSize="11" Foreground="{DynamicResource StatusText}" Text="{Binding StatusText}" />
                                        </Border>
                                        <TextBlock Margin="8,0,0,0" FontSize="11.5" Foreground="{DynamicResource TextMuted}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="320" Text="{Binding Reason}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMuted}" Text="{Binding NetText}" />
                                    <Button Content="{loc:Loc Archive_RestoreRow}" Style="{StaticResource SecondaryButton}"
                                            Height="32" MinWidth="110"
                                            Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Caption}"
                           Text="{loc:Loc Archive_HistoryEmpty}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
