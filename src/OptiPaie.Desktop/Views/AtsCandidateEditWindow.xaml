<Window x:Class="OptiPaie.Desktop.Views.AtsCandidateEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{Binding HeaderTitle}" Height="600" Width="480"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="{Binding HeaderTitle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,6,0">
            <StackPanel>
                <!-- 3 required fields. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_LastName}" />
                        <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_FirstName}" />
                        <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>

                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="{loc:Loc Recruit_Phone}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Optional details, folded. -->
                <Expander Header="{loc:Loc Recruit_More}" Margin="0,14,0,0" Foreground="{DynamicResource TextMuted}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_Email}" />
                        <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_Education}" />
                                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding Education, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_Experience}" />
                                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{loc:Loc Recruit_Source}" />
                        <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="{loc:Loc Common_Notes}" />
                        <TextBox Style="{StaticResource AppTextBox}" Height="56" Margin="0,4,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Expander>

                <!-- Interviews + CV — only once the candidate is saved. -->
                <StackPanel Visibility="{Binding Exists, Converter={StaticResource BoolToVis}}">
                    <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,12" />

                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_Interviews}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Interviews}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center">
                                        <Run Text="{Binding ScheduledDate, StringFormat=dd/MM/yyyy, Mode=OneWay}" />
                                        <Run Text=" · " Foreground="{DynamicResource TextMuted}" />
                                        <Run Text="{Binding Type, Mode=OneWay}" />
                                        <Run Text="{Binding Result, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" />
                                    </TextBlock>
                                    <Button Grid.Column="1" Content="✕" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Deduction}" Cursor="Hand"
                                            Command="{Binding DataContext.DeleteInterviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Compact add-interview row. -->
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_AddInterview}" Margin="0,8,0,0" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" Width="120" Height="30" SelectedDate="{Binding InterviewDate}" />
                        <TextBox Grid.Column="2" Style="{StaticResource AppTextBox}" Height="30" ToolTip="{loc:Loc Recruit_InterviewType}" Text="{Binding InterviewType, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Grid.Column="4" Style="{StaticResource AppTextBox}" Height="30" ToolTip="{loc:Loc Recruit_InterviewResult}" Text="{Binding InterviewResult, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="6" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0"
                                Content="{loc:Loc Recruit_AddShort}" Command="{Binding AddInterviewCommand}" />
                    </Grid>

                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Recruit_Attachments}" FontWeight="SemiBold" Margin="0,16,0,0" />
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                                            Foreground="{DynamicResource Brand}" Content="{Binding FileName}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="1" Content="✕" Width="24" Height="24" Padding="0" Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Deduction}" Cursor="Hand"
                                            Command="{Binding DataContext.DeleteAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Height="30" Padding="12,0" Margin="0,8,0,0"
                            Content="{loc:Loc Recruit_AddCv}" Command="{Binding AddCvCommand}" />
                </StackPanel>

                <TextBlock Text="{loc:Loc Recruit_SaveFirst}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,0"
                           TextWrapping="Wrap" Visibility="{Binding Exists, Converter={StaticResource InverseBoolToVis}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
