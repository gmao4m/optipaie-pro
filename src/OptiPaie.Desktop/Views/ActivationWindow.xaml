<Window x:Class="OptiPaie.Desktop.Views.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiPaie PRO — Bienvenue"
        Width="480" SizeToContent="Height" MaxHeight="880" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}" Language="fr-FR"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <Window.Resources>
        <!-- Inline (per-field) error label: small, red, shown only when it has text. -->
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource StatusDangerText}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,5,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand header (emerald + gold identity) -->
        <Border Grid.Row="0" Background="{DynamicResource Brand}" Padding="28,24">
            <StackPanel>
                <Border Width="50" Height="50" CornerRadius="14" Background="#22FFFFFF" HorizontalAlignment="Left">
                    <Path Width="26" Height="26" Stretch="Uniform" Fill="{DynamicResource TextOnBrand}"
                          Data="{StaticResource IconWallet}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextOnBrand}"
                           FontSize="23" FontWeight="SemiBold" Margin="0,12,0,0" />
                <TextBlock Text="{Binding Subtitle}" Foreground="#D8EFE7" Margin="0,3,0,0" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22,28,24">

                <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,16" />

                <!-- Email -->
                <TextBlock Text="Adresse email" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotBusy}"
                         Height="42" Padding="12,0" VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource Surface}"
                         BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding EmailError}"
                           Visibility="{Binding EmailError, Converter={StaticResource NonEmptyToVis}}" />

                <!-- Password -->
                <TextBlock Text="Mot de passe" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                <PasswordBox x:Name="PasswordBox" IsEnabled="{Binding IsNotBusy}" KeyDown="Password_KeyDown"
                             PasswordChanged="Password_Changed"
                             Height="42" Padding="12,0" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource Surface}"
                             BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                <TextBlock Style="{StaticResource FieldError}" Text="{Binding PasswordError}"
                           Visibility="{Binding PasswordError, Converter={StaticResource NonEmptyToVis}}" />

                <!-- Company (activate only) -->
                <StackPanel Visibility="{Binding ShowCompanyField, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Nom de la société" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                    <TextBox Text="{Binding Company, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotBusy}"
                             Height="42" Padding="12,0" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource Surface}"
                             BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding CompanyError}"
                               Visibility="{Binding CompanyError, Converter={StaticResource NonEmptyToVis}}" />
                </StackPanel>

                <!-- License key (activate only) -->
                <StackPanel Visibility="{Binding ShowLicenseSection, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Clé de licence" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                    <TextBox x:Name="KeyBox"
                             Text="{Binding LicenseKey, UpdateSourceTrigger=PropertyChanged}"
                             TextChanged="KeyBox_TextChanged" IsEnabled="{Binding IsNotBusy}"
                             CharacterCasing="Upper" MaxLength="18"
                             FontFamily="{StaticResource MonoFont}" FontSize="17" FontWeight="SemiBold"
                             Height="46" Padding="12,0" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                             Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                    <TextBlock Text="{Binding KeyHint}" Style="{StaticResource Caption}" Margin="2,6,0,0" />
                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding KeyError}"
                               Visibility="{Binding KeyError, Converter={StaticResource NonEmptyToVis}}" />
                </StackPanel>

                <!-- Primary action (both modes) -->
                <Button Content="{Binding PrimaryButtonText}" Click="Submit_Click" IsEnabled="{Binding IsNotBusy}"
                        Style="{StaticResource PrimaryButton}" Height="46" Margin="0,18,0,0" />

                <!-- Status banner (flow + server messages) -->
                <Border Margin="0,14,0,0" CornerRadius="8" Padding="12,10"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NonEmptyToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BrandSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StatusDangerSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource StatusDangerText}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Recovery link (sign-in mode): switch to full activation with a license key -->
                <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0"
                           Visibility="{Binding ShowSwitchToLicense, Converter={StaticResource BoolToVis}}">
                    <Hyperlink Command="{Binding UseLicenseCommand}" Foreground="{DynamicResource BrandText}"
                               TextDecorations="Underline">
                        Utiliser une clé de licence
                    </Hyperlink>
                </TextBlock>

                <!-- Trial + support (activate only) -->
                <StackPanel Visibility="{Binding ShowLicenseSection, Converter={StaticResource BoolToVis}}">
                    <!-- Divider -->
                    <Grid Margin="0,20,0,16">
                        <Border Height="1" Background="{DynamicResource Border}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Canvas}" HorizontalAlignment="Center" Padding="10,0">
                            <TextBlock Text="OU" Style="{StaticResource Caption}" />
                        </Border>
                    </Grid>

                    <!-- Trial -->
                    <Border Style="{StaticResource Card}" Background="{DynamicResource SurfaceMuted}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding TrialInfoText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                            <Button Content="{Binding TrialButtonText}" Command="{Binding TrialCommand}"
                                    Style="{StaticResource SecondaryButton}" Height="42" Margin="0,14,0,0"
                                    Visibility="{Binding CanStartTrial, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Support contact (shown once the trial has ended) -->
                    <Border Margin="0,16,0,0" CornerRadius="8" Padding="16" Background="{DynamicResource StatusDangerSoft}"
                            Visibility="{Binding IsTrialExpired, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Essai terminé" FontWeight="SemiBold" Foreground="{DynamicResource StatusDangerText}"
                                       FontSize="14" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SupportText}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" FontSize="13" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading overlay: blocks input + shows the current step, preventing double-submit -->
        <Border Grid.RowSpan="2" Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="190" Height="6"
                             Foreground="{DynamicResource Accent}" Background="#33FFFFFF" BorderThickness="0" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" Margin="0,12,0,0"
                           HorizontalAlignment="Center" FontSize="13" TextWrapping="Wrap" MaxWidth="320" TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
