<Window x:Class="OptiPaie.Desktop.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <StackPanel Margin="22,20">
        <TextBlock x:Name="PromptLabel" Style="{StaticResource Caption}" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" MinHeight="46" MaxHeight="130" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10,7"
                 Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                 Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource StatusDangerText}" FontSize="11.5"
                   Margin="2,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Loc Common_Cancel}" Click="Cancel_Click" Style="{StaticResource SecondaryButton}"
                    Height="38" MinWidth="96" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="{loc:Loc Common_Ok}" Click="Ok_Click" Style="{StaticResource PrimaryButton}"
                    Height="38" MinWidth="96" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
