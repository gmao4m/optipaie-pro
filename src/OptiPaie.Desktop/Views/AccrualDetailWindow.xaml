<Window x:Class="OptiPaie.Desktop.Views.AccrualDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Accrual_Title}" Height="500" Width="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Accrual_Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding EmployeeName}" />
        </StackPanel>
        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Months}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="All" RowHeight="28" FontSize="12.5"
                  Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}"
                  AlternatingRowBackground="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Accrual_Month}" Binding="{Binding MonthName}" Width="*" />
                <DataGridTextColumn Header="{loc:Loc Accrual_Present}" Binding="{Binding Present}" Width="90" />
                <DataGridTextColumn Header="{loc:Loc Leave_Unpaid}" Binding="{Binding UnpaidDays}" Width="100" />
                <DataGridTextColumn Header="{loc:Loc Accrual_Accrued}" Binding="{Binding Accrued}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding TotalText}" />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
