<Window x:Class="OptiPaie.Desktop.Views.PayrollReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revue avant émission" Height="560" Width="860"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H2}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="Seule l'absence injustifiée (et la moitié d'une demi-journée) réduit la paie. Vérifiez avant d'émettre.  ·  فقط الغياب غير المبرَّر (ونصف نصف-اليوم) يُنقص الأجر." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="8" Padding="12,8"
                Background="{DynamicResource StatusDangerSoft}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                Visibility="{Binding HasNoData, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusDangerText}" Text="{Binding NoDataNote}" />
        </Border>

        <DataGrid Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True"
                  CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="All"
                  RowHeight="30" FontFamily="{StaticResource AppFont}" FontSize="12.5" Background="{DynamicResource Surface}"
                  RowBackground="{DynamicResource Surface}" AlternatingRowBackground="{DynamicResource SurfaceMuted}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employé" Binding="{Binding Employee}" Width="190" />
                <DataGridTextColumn Header="Jours dus" Binding="{Binding DaysDue}" Width="75" />
                <DataGridTextColumn Header="Travaillés" Binding="{Binding Worked}" Width="80" />
                <DataGridTextColumn Header="Absent" Binding="{Binding Absent}" Width="70" />
                <DataGridTextColumn Header="Congé" Binding="{Binding Leave}" Width="65" />
                <DataGridTextColumn Header="Demi" Binding="{Binding Half}" Width="55" />
                <DataGridTextColumn Header="Retenue" Binding="{Binding Deduction}" Width="100" />
                <DataGridTextColumn Header="Base (÷)" Binding="{Binding Basis}" Width="150" />
                <DataGridTextColumn Header="" Binding="{Binding Flag}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Annuler" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="Confirmer et émettre" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</Window>
