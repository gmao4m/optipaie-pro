<UserControl x:Class="OptiPaie.Desktop.Views.WorkforceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <!-- A key-figure tile in the effectif strip: caption + value, optionally clickable. -->
        <Style x:Key="FigureTile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <!-- One distribution bar: label · bar · effectif · part — the whole row drills to the list. -->
        <DataTemplate x:Key="BucketBar">
            <Border Cursor="Hand" Background="Transparent" Padding="0,4" ToolTip="{loc:Loc Common_Open}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenBucketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16"
                            Width="{Binding BarWidth}" CornerRadius="5" Background="{DynamicResource Brand}" />
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Margin="12,0,8,0"
                               FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Grid.Column="3" Text="{Binding PctText}" VerticalAlignment="Center" TextAlignment="Right"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Key figures strip. Headcount is NOT repeated here — it is the hero figure and the donut
             centre; the strip carries the flow/derived figures that give the period its context. -->
        <UniformGrid Rows="1" Columns="5">
            <Border Style="{StaticResource FigureTile}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_AverageAge}" />
                    <TextBlock Style="{StaticResource KpiValue}" FontSize="20" Text="{Binding AverageAgeText}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Text="{Binding AverageAgeNote}" />
                </StackPanel>
            </Border>
            <!-- Retirement (count + % of headcount; already-passed / no-birth-date surfaced below) -->
            <Border Style="{StaticResource FigureTile}" Cursor="Hand" ToolTip="{loc:Loc Common_Open}">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenRetirementCommand}" /></Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Workforce_Retirement_Tile}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource KpiValue}" FontSize="20" Text="{Binding RetirementText}" />
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="6,0,0,4" Text="{Binding RetirementPctText}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Text="{Binding RetirementSubText}"
                               Visibility="{Binding HasRetirementSub, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FigureTile}" Cursor="Hand">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenEntriesCommand}" /></Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Entries}" />
                    <TextBlock Style="{StaticResource KpiValue}" FontSize="20" Foreground="{DynamicResource StatusSuccessText}" Text="{Binding EntriesText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FigureTile}" Cursor="Hand">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenExitsCommand}" /></Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Exits}" />
                    <TextBlock Style="{StaticResource KpiValue}" FontSize="20" Foreground="{DynamicResource Warning}" Text="{Binding ExitsText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FigureTile}" Margin="0" ToolTip="{Binding TurnoverTooltip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Turnover}" />
                    <TextBlock Style="{StaticResource KpiValue}" FontSize="20" Text="{Binding TurnoverText}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Text="{Binding TurnoverRaw}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Analytical breakdowns: ONE switchable distribution (left) + department donut (right) -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="Auto" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <!-- Switchable distribution (bars only — the count and % sit inline, no duplicate table) -->
            <StackPanel Grid.Column="0">
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" Text="{loc:Loc Workforce_Distribution}" />
                    <ComboBox Style="{StaticResource AppComboBox}" HorizontalAlignment="Right" Width="210" Height="32"
                              ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" DisplayMemberPath="Label" />
                </Grid>
                <Border Margin="0,12,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource StatusPendingSoft}"
                        Visibility="{Binding CurrentUnreliable, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource StatusPendingText}" Text="{Binding UnreliableText}" />
                </Border>

                <!-- Bars: for the small-category axes (contract, gender, age band, …) -->
                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding CurrentBuckets}" ItemTemplate="{StaticResource BucketBar}"
                              Visibility="{Binding CurrentIsBars, Converter={StaticResource BoolToVis}}" />

                <!-- Table: for « poste » (many single-count rows) — compact, sorted, scrollable -->
                <StackPanel Margin="0,10,0,0" Visibility="{Binding CurrentIsTable, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Axis_Poste}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Col_Count}" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Col_Pct}" TextAlignment="Right" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                        <ItemsControl ItemsSource="{Binding CurrentBuckets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand" Background="Transparent" Padding="0,4" ToolTip="{loc:Loc Common_Open}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenBucketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextAlignment="Right" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PctText}" FontSize="11.5" TextAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>

            <!-- Department donut + clickable legend -->
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,10" Text="{loc:Loc Workforce_ByDepartment}" />
                <StackPanel Orientation="Horizontal">
                    <Grid Width="192" Height="192" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding DeptSlices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Path Data="{Binding PathData}" Fill="{Binding Fill}" Stroke="{DynamicResource Surface}" StrokeThickness="2"
                                          Cursor="Hand" ToolTip="{loc:Loc Common_Open}">
                                        <Path.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.OpenDeptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Path.InputBindings>
                                    </Path>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding HeadcountText}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{loc:Loc Workforce_Headcount}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding DeptSlices}" VerticalAlignment="Center" Margin="18,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Cursor="Hand" Padding="0,3" ToolTip="{loc:Loc Common_Open}">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.OpenDeptCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid MinWidth="150">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="11" Height="11" CornerRadius="3" Background="{Binding Fill}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                            <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PercentText, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
