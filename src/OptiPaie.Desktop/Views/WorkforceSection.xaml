<UserControl x:Class="OptiPaie.Desktop.Views.WorkforceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <!-- One distribution bucket: label · bar · effectif · part — the whole row drills to the list. -->
        <DataTemplate x:Key="BucketBar">
            <Border Cursor="Hand" Background="Transparent" Padding="0,3" ToolTip="{loc:Loc Common_Open}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.OpenBucketCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" />
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Height="16"
                            Width="{Binding BarWidth}" CornerRadius="4" Background="{DynamicResource Brand}" />
                    <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center" Margin="10,0,8,0"
                               FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Grid.Column="3" Text="{Binding PctText}" VerticalAlignment="Center" TextAlignment="Right"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header: section title + period selector + "as of" note -->
        <Grid>
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Workforce_Section}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Text="{Binding AsOfText}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding PeriodLabel}" />
                <ComboBox Style="{StaticResource AppComboBox}" Width="130" Height="32"
                          ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" DisplayMemberPath="Label" />
            </StackPanel>
        </Grid>

        <!-- Key figures — each tile clickable to its nominative list -->
        <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Border Style="{StaticResource Card}" Width="190" Margin="0,0,12,12" Cursor="Hand">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenHeadcountCommand}" /></Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Headcount}" />
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding HeadcountText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="210" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_AverageAge}" />
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AverageAgeText}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap" Text="{Binding AverageAgeNote}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="160" Margin="0,0,12,12" Cursor="Hand">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenEntriesCommand}" /></Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Entries}" />
                    <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource Salary}" Text="{Binding EntriesText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="160" Margin="0,0,12,12" Cursor="Hand">
                <Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding OpenExitsCommand}" /></Border.InputBindings>
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Exits}" />
                    <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource Warning}" Text="{Binding ExitsText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="230" Margin="0,0,12,12" ToolTip="{Binding TurnoverTooltip}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Workforce_Turnover}" />
                    <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TurnoverText}" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap" Text="{Binding TurnoverRaw}" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Distribution panel: one axis at a time — bars (comprendre) + table copiable (vérifier) -->
        <Border Style="{StaticResource Card}" Margin="0,2,0,0">
            <StackPanel>
                <Grid>
                    <TextBlock Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Text="{loc:Loc Workforce_Distribution}" />
                    <ComboBox Style="{StaticResource AppComboBox}" HorizontalAlignment="Right" Width="200" Height="32"
                              ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" DisplayMemberPath="Label" />
                </Grid>

                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="8" Background="{DynamicResource SurfaceMuted}"
                        Visibility="{Binding CurrentUnreliable, Converter={StaticResource BoolToVis}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Warning}" Text="{Binding UnreliableText}" />
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- graphique -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding CurrentBuckets}" ItemTemplate="{StaticResource BucketBar}" />

                    <!-- tableau copiable -->
                    <DataGrid Grid.Column="2" ItemsSource="{Binding CurrentBuckets}" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                              Background="Transparent" BorderThickness="0" RowBackground="{DynamicResource Surface}"
                              AlternatingRowBackground="{DynamicResource SurfaceMuted}" HorizontalGridLinesBrush="{DynamicResource Border}"
                              FontSize="12" VerticalAlignment="Top">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Workforce_Col_Label}" Binding="{Binding Label}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Workforce_Col_Count}" Binding="{Binding CountText}" Width="70" />
                            <DataGridTextColumn Header="{loc:Loc Workforce_Col_Pct}" Binding="{Binding PctText}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Structure: par département + par poste -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Workforce_ByDepartment}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding DepartmentBuckets}" ItemTemplate="{StaticResource BucketBar}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc Workforce_ByPoste}" />
                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PosteBuckets}" ItemTemplate="{StaticResource BucketBar}" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
