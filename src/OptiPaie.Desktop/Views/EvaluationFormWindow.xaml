<Window x:Class="OptiPaie.Desktop.Views.EvaluationFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Perf_Evaluation}" Height="660" Width="880" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource AppFont}" Background="{DynamicResource Canvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header: employee + live total -->
        <Border Grid.Row="0" Background="{DynamicResource Brand}" Padding="22,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="{loc:Loc Perf_LiveScore}" Foreground="{DynamicResource TextOnBrandMuted}" FontSize="11" TextAlignment="Right" />
                    <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource TextOnBrand}" FontFamily="{StaticResource MonoFont}" FontSize="26" FontWeight="Bold" TextAlignment="Right" />
                    <Border HorizontalAlignment="Right" Style="{StaticResource StatusPill}" Margin="0,4,0,0"><TextBlock Style="{StaticResource PillText}" Text="{Binding BandLabel}" /></Border>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding EmployeeName}" Foreground="{DynamicResource TextOnBrand}" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EmployeeMeta}" Foreground="{DynamicResource TextOnBrandMuted}" FontSize="12.5" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding PeriodName}" Foreground="{DynamicResource TextOnBrandMuted}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- body: criteria | behaviour -->
        <Grid Grid.Row="1" Margin="22,16,22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- criteria cards -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Criteria}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource BrandSoft}" CornerRadius="6" Padding="8,3">
                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{DynamicResource BrandText}">
                                                <Run Text="{Binding NormalizedText, Mode=OneWay}" /><Run Text=" / 100" FontSize="10" />
                                            </TextBlock>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- rating input (stars / 20 / percent) -->
                                    <Grid Margin="0,10,0,0" Visibility="{Binding IsRating, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" VerticalAlignment="Center" Minimum="0" Maximum="{Binding Max}"
                                                TickFrequency="{Binding Tick}" IsSnapToTickEnabled="True" Value="{Binding RawValue}" />
                                        <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                                   FontWeight="SemiBold" Text="{Binding RawValueText}" />
                                    </Grid>

                                    <!-- KPI input (target / achieved -> %) -->
                                    <Grid Margin="0,10,0,0" Visibility="{Binding IsKpi, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_KpiTargetLabel}" />
                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,2,0,0" Text="{Binding TargetText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_KpiActual}" />
                                            <TextBox Style="{StaticResource AppTextBox}" Height="32" Margin="0,2,0,0" Text="{Binding ActualText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" TextAlignment="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource MonoFont}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource BrandText}" Text="{Binding AchievementText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- behaviour side panel -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Text="{loc:Loc Perf_Behaviors}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,10">
                        <Button Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,8,0" Command="{Binding AddPositiveCommand}">
                            <TextBlock><Run Text="👍 " /><Run Text="{loc:Loc Perf_Positive}" /></TextBlock>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="30" Command="{Binding AddNegativeCommand}">
                            <TextBlock><Run Text="👎 " /><Run Text="{loc:Loc Perf_Negative}" /></TextBlock>
                        </Button>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Behaviors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontSize="15" VerticalAlignment="Top" Margin="0,0,8,0" />
                                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}" Text="{Binding DateText}" VerticalAlignment="Top" Margin="6,0,0,0" />
                                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Perf_NoBehavior}" Margin="0,8,0,0"
                                       Visibility="{Binding HasBehaviors, Converter={StaticResource InverseBoolToVis}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- footer: note + actions -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox Style="{StaticResource AppTextBox}" Height="38" VerticalContentAlignment="Center"
                             ToolTip="{loc:Loc Perf_Observations}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="{loc:Loc Common_Cancel}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" Command="{Binding CancelCommand}" />
                    <Button Content="{loc:Loc Common_Save}" Style="{StaticResource SecondaryButton}" Height="38" Margin="0,0,10,0" MinWidth="120" Command="{Binding SaveCommand}" />
                    <Button Content="{loc:Loc Perf_Complete}" Style="{StaticResource PrimaryButton}" Height="38" MinWidth="150" Command="{Binding CompleteCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
