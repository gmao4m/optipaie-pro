<Window x:Class="OptiPaie.Desktop.Views.AbsenceCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{loc:Loc Calendar_Title}" Height="540" Width="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Style="{StaticResource H2}" Text="{loc:Loc Calendar_Title}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" Text="{Binding CompanyName}" />
            </StackPanel>
            <ComboBox Style="{StaticResource AppComboBox}" Width="90" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top"
                      ItemsSource="{Binding Years}" SelectedItem="{Binding Year}" />
        </Grid>
        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Absences}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False" GridLinesVisibility="All" RowHeight="28" FontSize="12.5"
                  Background="{DynamicResource Surface}" RowBackground="{DynamicResource Surface}"
                  AlternatingRowBackground="{DynamicResource SurfaceMuted}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                  HorizontalGridLinesBrush="{DynamicResource Border}" VerticalGridLinesBrush="{DynamicResource Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Loc Payroll_Employee}" Binding="{Binding EmployeeName}" Width="*" />
                <DataGridTextColumn Header="{loc:Loc Common_Type}" Binding="{Binding TypeLabel}" Width="150" />
                <DataGridTextColumn Header="{loc:Loc Leave_Period}" Binding="{Binding Period}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight" /></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:Loc Leave_Days}" Binding="{Binding DaysText}" Width="70" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding StatusMessage}" />
            <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Content="{loc:Loc Common_Close}" Command="{Binding CloseCommand}" />
        </Grid>
    </Grid>
</Window>
