<UserControl x:Class="OptiPaie.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization">
    <UserControl.Resources>
        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="208" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.07" RenderingBias="Quality" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <!-- soft-tinted accent circle for each KPI -->
        <Style x:Key="KpiIcon" TargetType="Border">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="19" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource H1}" Text="{Binding Greeting}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" Text="{Binding DateLabel}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common_Refresh}" Command="{Binding RefreshCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{loc:Loc Dashboard_NewPayroll}" Command="{Binding NewPayrollCommand}" />
                </StackPanel>
            </Grid>

            <!-- KPI cards — each with a soft-tinted accent circle + icon so the board feels alive. -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
                <!-- Payroll headline: masse salariale + salaire moyen (lead the board). -->
                <Border Style="{StaticResource Kpi}" Width="238">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource BrandSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource BrandText}" Data="{StaticResource IconWallet}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_Masse}" />
                            <TextBlock Style="{StaticResource KpiValue}" FontSize="17" Text="{Binding MasseSalariale}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}" Width="238">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource StatusSuccessSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource StatusSuccessText}" Data="{StaticResource IconWallet}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_AvgSalary}" />
                            <TextBlock Style="{StaticResource KpiValue}" FontSize="17" Foreground="{DynamicResource Salary}" Text="{Binding SalaireMoyen}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource BrandSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource BrandText}" Data="{StaticResource IconUsers}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_Headcount}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Employees}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource StatusSuccessSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource StatusSuccessText}" Data="{StaticResource IconCheck}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_PresentToday}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource Salary}" Text="{Binding PresentToday}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource AccentSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Accent}" Data="{StaticResource IconPlane}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_OnLeave}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource TextPrimary}" Text="{Binding OnLeave}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource AccentSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Accent}" Data="{StaticResource IconGlobe}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_OnMission}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource TextPrimary}" Text="{Binding OnMission}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource BrandSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource BrandText}" Data="{StaticResource IconFileCheck}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_ActiveContracts}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding ActiveContracts}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource StatusPendingSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource StatusPendingText}" Data="{StaticResource IconClock}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_ExpiringContracts}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource Warning}" Text="{Binding Expiring}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource StatusPendingSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource StatusPendingText}" Data="{StaticResource IconCalendar}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_PendingLeave}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource Warning}" Text="{Binding PendingLeave}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource StatusDangerSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource StatusDangerText}" Data="{StaticResource IconWallet}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_LoanOutstanding}" />
                            <TextBlock Style="{StaticResource KpiValue}" Foreground="{DynamicResource Deduction}" Text="{Binding LoanOutstanding}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource BrandSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource BrandText}" Data="{StaticResource IconClipboard}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_OpenPostings}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding OpenPostings}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource AccentSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource Accent}" Data="{StaticResource IconUserPlus}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_Candidates}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Candidates}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource BrandSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource BrandText}" Data="{StaticResource IconLaptop}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_AssetsAssigned}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding AssetsAssigned}" /></StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Kpi}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource KpiIcon}" Background="{DynamicResource StatusSuccessSoft}">
                            <Path Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource StatusSuccessText}" Data="{StaticResource IconSchool}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{loc:Loc Dashboard_Kpi_TrainingUpcoming}" />
                            <TextBlock Style="{StaticResource KpiValue}" Text="{Binding TrainingUpcoming}" /></StackPanel>
                    </Grid>
                </Border>
            </WrapPanel>

            <!-- Charts: masse salariale over months + employee distribution by department -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" MinWidth="332" />
                </Grid.ColumnDefinitions>

                <!-- Masse salariale trend (bar chart) -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="15" Text="{loc:Loc Dashboard_MasseTrend}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="{loc:Loc Dashboard_Last6Months}" />
                        <ItemsControl ItemsSource="{Binding SalaryTrend}" Margin="0,16,0,2" Height="206">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="7,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding AmountText}" FontSize="10.5" FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                        <Border Grid.Row="1" Height="{Binding HeightPx}" Background="{Binding Fill}" CornerRadius="6,6,0,0" VerticalAlignment="Bottom" />
                                        <TextBlock Grid.Row="2" Text="{Binding MonthLabel}" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,7,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Department distribution (donut + legend) -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" FontSize="15" Text="{loc:Loc Dashboard_DeptDistribution}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Grid Width="192" Height="192" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding DeptSlices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Path Data="{Binding PathData}" Fill="{Binding Fill}" Stroke="{DynamicResource Surface}" StrokeThickness="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Employees}" FontFamily="{StaticResource MonoFont}" FontSize="27" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{loc:Loc Dashboard_Kpi_Headcount}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding DeptSlices}" VerticalAlignment="Center" Margin="20,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5" MinWidth="150">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="11" Height="11" CornerRadius="3" Background="{Binding Fill}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                                <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding PercentText, Mode=OneWay}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Approvals + deadlines -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Approvals queue -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource H2}" FontSize="15" Text="{Binding ApprovalsHeader}" Margin="16,14,16,8" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Approvals}" Margin="8,0,8,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch" Cursor="Hand" BorderThickness="0" Background="Transparent"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding ModuleKey}">
                                        <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="8" Padding="12,9" Margin="0,2">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{loc:Loc Dashboard_Process}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource BrandText}" FontWeight="SemiBold" FontSize="12" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="1" Text="{loc:Loc Dashboard_NoApprovals}" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                                   Visibility="{Binding HasApprovals, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Deadlines -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource H2}" FontSize="15" Text="{Binding DeadlinesHeader}" Margin="16,14,16,8" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Deadlines}" Margin="8,0,8,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Stretch" Cursor="Hand" BorderThickness="0" Background="Transparent"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding ModuleKey}">
                                        <Border Background="{DynamicResource SurfaceMuted}" CornerRadius="8" Padding="12,9" Margin="0,2">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="1" Text="{loc:Loc Dashboard_NoDeadlines}" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20"
                                   Visibility="{Binding HasDeadlines, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Activity journal (audit trail) -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" FontSize="15" Text="{loc:Loc Dashboard_ActivityLog}" Margin="16,14,16,8" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="14,0,14,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Text}" FontSize="12.5" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Dashboard_NoActivity}" Foreground="{DynamicResource TextMuted}"
                               Margin="16,0,0,14" Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- Quick actions -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Employees_New}" Command="{Binding NewEmployeeCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{loc:Loc Dashboard_AttendanceMatrix}" Command="{Binding AttendanceCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{loc:Loc Dashboard_Leave}" Command="{Binding LeaveCommand}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
