<Window x:Class="OptiPaie.Desktop.Views.LeaveEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="{Binding Title}" Height="480" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource H2}" Text="{Binding Title}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,6,0">
            <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Payroll_Employee}" />
            <ComboBox Style="{StaticResource AppComboBox}" Height="32" Margin="0,4,0,0"
                      ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                      IsEnabled="{Binding CanChooseEmployee}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding LastNameFr}" />
                            <Run Text="{Binding FirstNameFr}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="{loc:Loc Leave_TypeField}" />
            <ComboBox Style="{StaticResource AppComboBox}" Height="32" Margin="0,4,0,0"
                      ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" DisplayMemberPath="Label" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Common_From}" />
                    <DatePicker Height="32" Margin="0,4,0,0" SelectedDate="{Binding StartDate}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Common_To}" />
                    <DatePicker Height="32" Margin="0,4,0,0" SelectedDate="{Binding EndDate}" />
                </StackPanel>
            </Grid>

            <!-- Aperçu à la saisie : jours décomptés, catégorie de paiement, impact sur le solde -->
            <Border Background="{DynamicResource BrandSoft}" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DaysText}" />
                    <WrapPanel Margin="0,8,0,0">
                        <Border Style="{StaticResource StatusPill}" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding PaymentLabel}" />
                        </Border>
                        <Border Style="{StaticResource StatusPill}">
                            <TextBlock Style="{StaticResource PillText}" Text="{Binding DecrementsLabel}" />
                        </Border>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding BalanceText, Converter={StaticResource NonEmptyToVis}}">
                        <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc Leave_ColBalance}" VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="13" FlowDirection="LeftToRight"
                                   Foreground="{DynamicResource TextPrimary}" Text="{Binding BalanceText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Alerte précise (solde insuffisant / chevauchement / employé non actif) AVANT validation -->
            <Border Background="{DynamicResource StatusDangerSoft}" CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                    Visibility="{Binding HasAlert, Converter={StaticResource BoolToVis}}">
                <TextBlock Foreground="{DynamicResource StatusDangerText}" FontSize="12.5" TextWrapping="Wrap" Text="{Binding AlertText}" />
            </Border>

            <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="{loc:Loc Leave_Reason}" />
            <TextBox Style="{StaticResource AppTextBox}" Height="60" Margin="0,4,0,0"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{loc:Loc Leave_SaveDraft}" Command="{Binding SaveDraftCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{loc:Loc Leave_ActSubmit}" Command="{Binding SubmitCommand}" />
        </StackPanel>
    </Grid>
</Window>
