<Window x:Class="OptiPaie.Desktop.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OptiPaie PRO" Height="640" Width="560"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <Grid>
        <Border Style="{StaticResource Card}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
            <StackPanel>
                <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brand}" HorizontalAlignment="Center">
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource TextOnBrand}" Data="{StaticResource IconWallet}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ProductName}" HorizontalAlignment="Center" Margin="0,12,0,0"
                           FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />

                <!-- STEP: reset with the one-time code -->
                <StackPanel Visibility="{Binding IsResetStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Intro}" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource TextMuted}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,4" Text="{Binding CodeLabel}" />
                    <TextBox x:Name="CodeBox" Style="{StaticResource AppTextBox}"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,4" Text="{Binding PasswordLabel}" />
                    <PasswordBox x:Name="PasswordBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderStrong}" FontFamily="{StaticResource AppFont}" FontSize="13.5" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,4" Text="{Binding ConfirmLabel}" />
                    <PasswordBox x:Name="ConfirmBox" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                                 Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                 BorderBrush="{DynamicResource BorderStrong}" FontFamily="{StaticResource AppFont}" FontSize="13.5" />

                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Deduction}"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Content="{Binding RecoverButton}"
                            Command="{Binding RecoverCommand}" IsDefault="True" />

                    <Button Content="{Binding NeitherLink}" Command="{Binding ShowFallbackCommand}"
                            HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="0" FontSize="12"
                            Foreground="{DynamicResource Brand}" />
                </StackPanel>

                <!-- STEP: show the fresh recovery code -->
                <StackPanel Visibility="{Binding IsSuccessStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding SuccessTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SuccessIntro}" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource TextMuted}" />

                    <Border Margin="0,18,0,0" CornerRadius="10" Padding="16,18"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <TextBox Text="{Binding NewRecoveryCode, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 FontFamily="Consolas" FontSize="26" FontWeight="Bold" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Content="{Binding CopyButton}" Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="18,0" Click="OnCopyCode" />
                        <Button Content="{Binding PrintButton}" Style="{StaticResource SecondaryButton}"
                                Height="34" Padding="18,0" Margin="10,0,0,0" Click="OnPrintCode" />
                    </StackPanel>

                    <CheckBox Margin="0,18,0,0" IsChecked="{Binding SavedConfirmed, Mode=TwoWay}"
                              Foreground="{DynamicResource TextPrimary}" FontSize="12.5"
                              Content="{Binding SavedConfirmText}" />

                    <TextBlock Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Deduction}"
                               Text="{Binding StatusMessage}"
                               Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Content="{Binding FinishButton}"
                            Command="{Binding FinishCommand}" IsEnabled="{Binding SavedConfirmed}" />
                </StackPanel>

                <!-- STEP: neither password nor code — install fingerprint + vendor procedure -->
                <StackPanel Visibility="{Binding IsFallbackStep, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FallbackTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding FallbackIntro}" Margin="0,10,0,0" FontSize="12.5" TextWrapping="Wrap"
                               TextAlignment="Center" Foreground="{DynamicResource TextMuted}" />

                    <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,4" Text="{Binding FingerprintLabel}" />
                    <Border CornerRadius="10" Padding="14,14"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <TextBox Text="{Binding Fingerprint, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"
                                 HorizontalAlignment="Center" TextAlignment="Center"
                                 FontFamily="Consolas" FontSize="14" />
                    </Border>

                    <Button Content="{Binding CopyFingerprintButton}" Style="{StaticResource SecondaryButton}"
                            Height="34" Padding="18,0" Margin="0,14,0,0" HorizontalAlignment="Center" Click="OnCopyFingerprint" />

                    <Button Style="{StaticResource PrimaryButton}" Margin="0,18,0,0" Content="رجوع / Retour"
                            Command="{Binding BackToResetCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
