<Window x:Class="OptiPaie.Desktop.Views.CompanySelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="OptiPaie PRO" Height="600" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource Canvas}" FontFamily="{StaticResource AppFont}">
    <Window.Resources>
        <!-- One clickable company row: a themed card with a hover accent. Clicking it opens
             the company directly — there is no separate "validate" button. -->
        <Style x:Key="CompanyCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="12" Padding="14">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource Card}" Width="416" MaxHeight="548"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="26">
            <DockPanel LastChildFill="True">
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brand}" HorizontalAlignment="Center">
                        <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource TextOnBrand}" Data="{StaticResource IconBuilding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{loc:Loc CompanyPick_Title}" HorizontalAlignment="Center" Margin="0,12,0,0"
                               FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="{loc:Loc CompanyPick_Subtitle}" HorizontalAlignment="Center" Margin="0,2,0,0"
                               FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- Create a company (also the only action in the empty state) -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0" Height="40"
                        Content="{loc:Loc CompanyPick_Create}" Command="{Binding CreateCommand}" />

                <!-- Empty state -->
                <TextBlock DockPanel.Dock="Top" Margin="0,26,0,0" Text="{loc:Loc CompanyPick_Empty}"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="13"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <!-- The clickable company list -->
                <ScrollViewer Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasCompanies, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Companies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CompanyCardButton}"
                                        Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding NameFr}" FontSize="14.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Nif}" FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
