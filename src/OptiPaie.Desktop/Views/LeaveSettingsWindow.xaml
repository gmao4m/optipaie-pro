<Window x:Class="OptiPaie.Desktop.Views.LeaveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OptiPaie.Desktop.Localization"
        Title="Paramètres des congés" Height="600" Width="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource H2}" Text="{loc:Loc LeaveSet_Title}" />
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:Loc LeaveSet_Hint}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0" Padding="0,0,6,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Caption}" Text="{loc:Loc LeaveSet_DaysPerMonth}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding DaysPerMonth, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0" Text="{loc:Loc LeaveSet_AnnualCap}" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Text="{Binding AnnualCap, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Margin="0,16,0,0" IsChecked="{Binding ExcludeRestDays}"
                          Content="{loc:Loc LeaveSet_ExcludeRest}" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="{loc:Loc LeaveSet_WeekendDays}" />
                <ItemsControl ItemsSource="{Binding WeekendDays}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,4,18,0" IsChecked="{Binding IsOff}" Content="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Options réglementaires par société (loi 90-11). Elles étaient stockées mais sans
                     écran de saisie, et réinitialisées à chaque sauvegarde ; on les expose ici. -->
                <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0" Text="Règles réglementaires" />
                <CheckBox Margin="0,8,0,0" IsChecked="{Binding ExcludeHolidays}"
                          Content="Ne pas décompter les jours fériés inclus dans un congé" />
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding CalendarDayCount}"
                          Content="Décompter en jours calendaires (au lieu des jours ouvrés)" />
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding ReferenceJulyToJune}"
                          Content="Année de référence de juillet à juin" />
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding AccrualExcludesUnpaid}"
                          Content="Ne pas acquérir de congé pendant un congé sans solde" />
                <CheckBox Margin="0,6,0,0" IsChecked="{Binding StrictCnasTreatment}"
                          Content="Traitement CNAS strict (congés à charge de la sécurité sociale)" />

                <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,0" Text="Congé de maternité (jours)" />
                <TextBox Style="{StaticResource AppTextBox}" Margin="0,4,0,0" Width="120" HorizontalAlignment="Left"
                         Text="{Binding MaternityDays, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc Common_Cancel}" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{loc:Loc Common_Save}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
