<Application x:Class="OptiPaie.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OptiPaie.Desktop.Converters"
             xmlns:beh="clr-namespace:OptiPaie.Desktop.Behaviors">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Typography.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:EnumToFrenchConverter x:Key="EnumFr" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyToVis" />
            <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyToVis" />
            <conv:SeverityToBrushConverter x:Key="SeverityBrush" />
            <conv:BytesToImageConverter x:Key="BytesToImage" />
            <conv:BoolToFontWeightConverter x:Key="BoolToWeight" />
            <conv:GainToBrushConverter x:Key="GainBrush" />
            <conv:InitialsConverter x:Key="Initials" />
            <conv:ElementNatureConverter x:Key="ElementNature" />
            <!-- Decimal input that accepts comma OR dot regardless of Windows locale — used on
                 every editable numeric field (base, taux, montants, quantités, heures, %). -->
            <conv:FlexibleDecimalConverter x:Key="FlexNum" />

            <!-- Every dialog/window is capped to the visible screen so tall forms never grow
                 off-screen (the main maximized shell is skipped by the behavior). Combined with
                 a ScrollViewer body + fixed footer per form, Save/Cancel stay reachable. -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="beh:DialogChrome.FitScreen" Value="True" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
